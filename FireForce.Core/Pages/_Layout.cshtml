@using Microsoft.AspNetCore.Components.Web
@namespace FireForce.Core.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/abm.css" rel="stylesheet" />
    @* CSS isolation: hoy no hay ningún .razor.css en el proyecto, así que el SDK no genera
       el bundle y linkearlo daría 404. Si algún día se usa la feature, el link correcto es
       <link href="FireForce.Core.styles.css" rel="stylesheet" /> (según el nombre del assembly;
       el viejo "Core.styles.css" era un 404 silencioso y por eso los .razor.css nunca aplicaron). *@
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()
    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
