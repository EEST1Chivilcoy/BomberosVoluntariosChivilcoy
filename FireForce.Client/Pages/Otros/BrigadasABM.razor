@page "/fire-force/Brigadas"
@using FireForce.Data.Models.Grupos.Brigadas
@using FireForce.Client.Data.ViewModels.Personal
@using FireForce.Data.Models.Personas.Personal
@using FireForce.Data.Models.Personas.Personal.Componentes
@using FireForce.Client.Data.Mappers

@*Servicios Utilizados*@
@using FireForce.Client.Services
@inject IBrigadaService BrigadaService
@inject IBomberoService BomberoService
@inject IMessageService MessageService

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AdminOnly")]

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<div class="abm-page abm-page--titulo-acciones abm-page--brigadas">
    <div class="abm-container">
        <Card Class="abm-main-card">
            <div class="abm-header-section">
                <div class="lava-bubbles">
                    <div class="lava-bubble b1"></div>
                    <div class="lava-bubble b2"></div>
                    <div class="lava-bubble b3"></div>
                    <div class="lava-bubble b4"></div>
                    <div class="lava-bubble b5"></div>
                </div>
                <div class="title-container">
                    <h1 class="main-title">
                        <Icon Type="team" Class="title-icon" />
                        BRIGADAS
                    </h1>
                </div>
                <div class="actions-row">
                    <Button Class="modern-button add-button"
                            OnClick="() => ViewAddBrigade()"
                            Icon="plus"
                            Size="ButtonSize.Large">
                        Nueva Brigada
                    </Button>
                </div>
            </div>
            <div class="abm-table-container">
                <Table TItem="BrigadaViewModelTable"
                       DataSource="@BrigadaViewModels"
                       @bind-PageIndex="_pageIndex"
                       @bind-PageSize="_pageSize"
                       Responsive>
                    <ColumnDefinitions Context="brigada">
                        <PropertyColumn Title="🏷️ Nombre"
                                        Property="b => b.Nombre"
                                        Sortable
                                        Width="220px"
                                        Fixed="ColumnFixPlacement.Left">
                        </PropertyColumn>
                        <PropertyColumn Title="👤 Encargado"
                                        Property="b => b.EncargadoApellidoYNombre"
                                        Sortable
                                        Width="220px">
                        </PropertyColumn>
                        <ActionColumn Title="⚙️ Acciones" Align=ColumnAlign.Center Width="180px">
                            <Space>
                                <SpaceItem>
                                    <Button OnClick="() => ViewBrigadeDetails(brigada.Id)">
                                        <Icon Type="team" />
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Popconfirm Title="¿Eliminar esta brigada?"
                                                OnConfirm="() => DeleteBrigade(brigada.Id)"
                                                OkText="Si"
                                                CancelText="No">
                                        <Button Danger>
                                            <Icon Type="delete" />
                                        </Button>
                                    </Popconfirm>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button Type="@ButtonType.Primary" OnClick="() => ViewEditBrigade(brigada.Id)" Ghost>
                                        <Icon Type="edit" />
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>
                </Table>
            </div>
        </Card>
    </div>
</div>

@*Modal para Añadir Brigada con diseño de Licencias*@
<Modal @bind-Visible="_modalAñadirVisible"
       Title="Añadir Brigada"
       Width="@("100%")"
       Style="max-width: 800px;"
       Footer="null"
       DestroyOnClose
       Centered
       WrapClassName="modal-abm modal-crear-brigada">
    <div class="modal-content-abm">
        <Form Model="newBrigada" Layout="FormLayout.Vertical" OnFinish="AddBrigade">
            <Row Gutter="16">
                <AntDesign.Col Span="16">
                    <FormItem Label="Nombre" Required Class="modal-form-item-abm">
                        <Input @bind-Value="newBrigada.Nombre" Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
                <AntDesign.Col Span="8">
                    <FormItem Label="Encargado" Required Class="modal-form-item-abm">
                        <Select TItem="BomberoViweModel"
                                TItemValue="BomberoViweModel"
                                DataSource="@bomberosTodosViewModel"
                                @bind-Value="newBrigada.Encargado"
                                LabelName="@nameof(BomberoViweModel.ApellidoYNombre)"
                                Placeholder="Seleccione un bombero"
                                DefaultActiveFirstOption="false"
                                AllowClear="true"
                                EnableSearch
                                Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
            </Row>
            <div class="modal-footer-abm">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Size="ButtonSize.Large">
                    Guardar
                </Button>
            </div>
        </Form>
    </div>
</Modal>

@*Modal para Editar Brigada con diseño de Licencias*@
<Modal @bind-Visible="_modalEditarVisible"
       Title="Editar Brigada"
       Width="@("100%")"
       Style="max-width: 800px;"
       Footer="null"
       DestroyOnClose
       Centered
       WrapClassName="modal-abm modal-crear-brigada">
    <div class="modal-content-abm">
        <Form Model="selBrigada" Layout="FormLayout.Vertical" OnFinish="EditBrigade">
            <Row Gutter="16">
                <AntDesign.Col Span="16">
                    <FormItem Label="Nombre" Required Class="modal-form-item-abm">
                        <Input @bind-Value="selBrigada.Nombre" Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
                <AntDesign.Col Span="8">
                    <FormItem Label="Encargado" Required Class="modal-form-item-abm">
                        <Select TItem="BomberoViweModel"
                                TItemValue="BomberoViweModel"
                                DataSource="@bomberosTodosViewModel"
                                @bind-Value="selBrigada.Encargado"
                                LabelName="@nameof(BomberoViweModel.ApellidoYNombre)"
                                Placeholder="Seleccione un bombero"
                                DefaultActiveFirstOption="false"
                                AllowClear="true"
                                EnableSearch
                                Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
            </Row>
            <div class="modal-footer-abm">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Size="ButtonSize.Large">
                    Editar
                </Button>
            </div>
        </Form>
    </div>
</Modal>

<Modal @bind-Visible="_modalDetallesVisible"
       Title="@TitleBrigadaSel"
       Footer="null"
       Maximizable="@true"
       Centered
       Width="800"
       WrapClassName="modal-abm modal-crear-brigada">
    <div class="modal-content-abm">
        <BomberosBrigada BrigadaId="@IdBrigadaSel"></BomberosBrigada>
    </div>
</Modal>

@code {
    // Lista con todos los bomberos
    private List<Bombero> bomberosTodos = new();
    private List<BomberoViweModel> bomberosTodosViewModel = new();
    // Lista de Brigadas
    private List<Brigada> Brigadas = new List<Brigada>();
    private List<BrigadaViewModelTable> BrigadaViewModels = new List<BrigadaViewModelTable>();

    // Modals
    private bool _modalAñadirVisible = false;
    private bool _modalDetallesVisible = false;
    private bool _modalEditarVisible = false;

    // Variables
    private BrigadaViewModelTable newBrigada = new();
    private BrigadaViewModelTable selBrigada = new();
    private string? TitleBrigadaSel;
    private int IdBrigadaSel;

    // Variables de Tamaño de la Tabla
    int _pageIndex = 1;
    int _pageSize = 5;

    public class BrigadaViewModelTable
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = null!;
        public string? EncargadoApellidoYNombre { get; set; }
        public BomberoViweModel Encargado { get; set; } = null!;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarBomberos();
        await CargarBrigadas();
    }
    private async Task CargarBomberos()
    {
        bomberosTodos = await BomberoService.ObtenerTodosLosBomberosAsync() ?? new();
        bomberosTodosViewModel = bomberosTodos.ToBomberoViewModelList() ?? new List<BomberoViweModel>();
    }

    private async Task CargarBrigadas()
    {
        Brigadas = await BrigadaService.ObtenerTodasLasBrigadasAsync() ?? new();

        // Reconstruir SIEMPRE el listado mapeado: si se corta antes (como
        // pasaba al borrar la última brigada), la tabla retiene filas viejas.
        // Una base sin brigadas es un estado normal, no un warning: la tabla
        // ya muestra "No hay datos".
        BrigadaViewModels = Brigadas.Select(b => new BrigadaViewModelTable
        {
            Id = b.BrigadaId,
            Nombre = b.NombreBrigada,
            EncargadoApellidoYNombre = b.Encargado != null
                ? $"{b.Encargado.Apellido}, {b.Encargado.Nombre}"
                : "Sin Encargado"
        }).ToList();
    }
    private void ViewAddBrigade()
    {
        if (bomberosTodos.Count == 0)
        {
            MessageService.Error("No hay bomberos disponibles para asignar como encargado.");
            return;
        }

        newBrigada = new BrigadaViewModelTable();
        _modalAñadirVisible = true;
    }

    private async Task AddBrigade()
    {
        if (newBrigada.Encargado?.NumeroLegajo is not int legajo)
        {
            MessageService.Error("El encargado de la brigada no puede estar vacío.");
            return;
        }
        if (string.IsNullOrWhiteSpace(newBrigada.Nombre))
        {
            MessageService.Error("El nombre de la brigada no puede estar vacío.");
            return;
        }

        try
        {
            Bombero BomberoEncargado = await BomberoService.ObtenerBomberoObjetoPorLegajoAsync(legajo);
            if (BomberoEncargado == null)
            {
                MessageService.Error("El encargado seleccionado no es válido.");
                return;
            }

            var brigada = new Brigada
            {
                NombreBrigada = newBrigada.Nombre,
                Encargado = BomberoEncargado
            };

            await BrigadaService.AgregarBrigadaAsync(brigada);
        }
        catch (Exception ex)
        {
            MessageService.Error($"No se pudo guardar la brigada: {ex.Message}");
            return;
        }

        newBrigada = new BrigadaViewModelTable();
        _modalAñadirVisible = false;
        await CargarBrigadas();
        MessageService.Success("Brigada añadida correctamente.");
    }

    private async Task ViewEditBrigade(int id)
    {
        if (id <= 0)
        {
            MessageService.Error("ID inválido. Por favor, proporcione un ID válido.");
            return;
        }

        var brigada = await BrigadaService.ObtenerBrigadaPorIdAsync(id);
        if (brigada == null)
        {
            MessageService.Error("Error al intentar editar la brigada: No se encontró.");
            return;
        }

        var encargado = bomberosTodosViewModel.FirstOrDefault(b => b.NumeroLegajo == brigada.Encargado?.NumeroLegajo);
        if (encargado == null)
        {
            MessageService.Error("Error al intentar editar la brigada: No se encontró un encargado válido.");
            return;
        }

        selBrigada = new BrigadaViewModelTable
        {
            Id = brigada.BrigadaId,
            Nombre = brigada.NombreBrigada,
            Encargado = encargado
        };

        _modalEditarVisible = true;
    }

    private async Task EditBrigade()
    {
        if (selBrigada.Encargado?.NumeroLegajo is not int legajo)
        {
            MessageService.Error("El encargado de la brigada no puede estar vacío.");
            return;
        }
        if (string.IsNullOrWhiteSpace(selBrigada.Nombre))
        {
            MessageService.Error("El nombre de la brigada no puede estar vacío.");
            return;
        }
        if (selBrigada.Id <= 0)
        {
            MessageService.Error("ID inválido. Por favor, proporcione un ID válido.");
            return;
        }

        try
        {
            var BomberoEncargado = await BomberoService.ObtenerBomberoObjetoPorLegajoAsync(legajo);
            if (BomberoEncargado == null)
            {
                MessageService.Error("El encargado seleccionado no es válido.");
                return;
            }

            var brigada = new Brigada
            {
                BrigadaId = selBrigada.Id,
                NombreBrigada = selBrigada.Nombre,
                Encargado = BomberoEncargado
            };

            await BrigadaService.EditarBrigadaAsync(brigada);
        }
        catch (Exception ex)
        {
            MessageService.Error($"No se pudo editar la brigada: {ex.Message}");
            return;
        }

        _modalEditarVisible = false;
        await CargarBrigadas();
        MessageService.Success("Brigada editada correctamente.");
    }

    private async Task ViewBrigadeDetails(int id)
    {
        var brigada = await BrigadaService.ObtenerBrigadaPorIdAsync(id);
        if (brigada == null)
        {
            MessageService.Error("Error al abrir la brigada: No se encontró.");
            return;
        }

        TitleBrigadaSel = brigada.NombreBrigada;
        IdBrigadaSel = brigada.BrigadaId;
        _modalDetallesVisible = true;
    }

    private async Task DeleteBrigade(int id)
    {
        try
        {
            await BrigadaService.EliminarBrigadaAsync(id);
        }
        catch (Exception ex)
        {
            MessageService.Error($"No se pudo eliminar la brigada: {ex.Message}");
            return;
        }

        await CargarBrigadas();
        MessageService.Success("Brigada eliminada con éxito.");
    }
}