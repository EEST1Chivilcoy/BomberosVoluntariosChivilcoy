@using FireForce.Client.Pages.Otros.PartesVehiculo.Componentes

@page "/fire-force/partes-vehiculos"

@*Servicios Utilizados*@
@using FireForce.Client.Services
@inject IMessageService MessageService
@inject IParteVehiculoService ParteVehiculoService

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AdminOnly")]

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<div class="abm-page abm-page--titulo-acciones abm-page--partes">
    <div class="abm-container">
        <Card Class="abm-main-card">
            <div class="abm-header-section">
                <div class="lava-bubbles">
                    <div class="lava-bubble b1"></div>
                    <div class="lava-bubble b2"></div>
                    <div class="lava-bubble b3"></div>
                    <div class="lava-bubble b4"></div>
                    <div class="lava-bubble b5"></div>
                </div>
                <div class="title-container">
                    <h1 class="main-title">
                        <Icon Type="car" Class="title-icon" />
                        PARTES VEHICULARES
                    </h1>
                </div>
                <div class="actions-row">
                    <Button Class="modern-button add-button"
                            OnClick="@(() => _modalAñadirVisible = true)"
                            Icon="plus"
                            Loading="_isLoading"
                            Size="ButtonSize.Large">
                        Nueva Parte
                    </Button>
                </div>
            </div>
            <div class="abm-table-container">
                <Table DataSource="@parteVehiculoViewModels"
                       @bind-PageIndex="_pageIndex"
                       @bind-PageSize="_pageSize"
                       Loading="_isLoading"
                       Responsive>
                    <ColumnDefinitions Context="partes">
                        <PropertyColumn Title="🏷️ Nombre"
                                        Property="p => p.Nombre"
                                        Align="ColumnAlign.Center"
                                        Sortable
                                        Width="220px"
                                        Fixed="ColumnFixPlacement.Left" />
                        <PropertyColumn Title="🚗 Tipo de Parte"
                                        Property="p => p.Tipo"
                                        Align="ColumnAlign.Center"
                                        Sortable
                                        Width="220px" />
                        <ActionColumn Title="⚙️ Acciones" Align=ColumnAlign.Center Width="180px">
                            <Space>
                                <SpaceItem>
                                    <Button Type="@ButtonType.Primary" Ghost OnClick="() => ShowEditar(partes.Id)">
                                        <Icon Type="edit" />
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>
                </Table>
            </div>
        </Card>
    </div>
</div>

@*Modal para Añadir Parte con diseño de Licencias*@
<Modal @bind-Visible="_modalAñadirVisible"
       Title="Añadir Parte Vehiculo"
       Width="@("100%")"
       Style="max-width: 800px;"
       Footer="null"
       DestroyOnClose
       Centered
       WrapClassName="modal-abm modal-crear-fuerza">
    <div class="modal-content-abm">
        <AgregarParteVehiculo OnCancel="CloseModals" />
    </div>
</Modal>

@*Modal para Editar Parte con diseño de Licencias*@
<Modal @bind-Visible="_modalEditarVisible"
       Title="Editar Parte Vehiculo"
       Width="@("100%")"
       Style="max-width: 800px;"
       Footer="null"
       DestroyOnClose
       Centered
       WrapClassName="modal-abm modal-crear-fuerza">
    <div class="modal-content-abm">
        <EditarParteVehiculo OnCancel="CloseModals" ParteVehiculoId="ParteSel" />
    </div>
</Modal>

@code {
    private List<ParteVehiculoViewModel> parteVehiculoViewModels = new();

    // Variables de Tamaño de la Tabla
    int _pageIndex = 1;
    int _pageSize = 15;

    // Loading de la Tabla
    bool _isLoading = true;

    // Modals
    private bool _modalAñadirVisible = false;
    private bool _modalEditarVisible = false;

    // Selected Parte Vehiculo Id para Editar
    private int ParteSel;

    // ViewModel
    public class ParteVehiculoViewModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Tipo { get; set; } = string.Empty;
    }

    // Close Modals
    public async Task CloseModals()
    {
        _modalAñadirVisible = false;
        _modalEditarVisible = false;
        await CargarPartesVehiculoAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarPartesVehiculoAsync();
    }

    private async Task CargarPartesVehiculoAsync()
    {
        _isLoading = true;

        try
        {
            var partes = await ParteVehiculoService.ObtenerTodasLasPartesVehiculoAsync();

            parteVehiculoViewModels = partes.Select(p => new ParteVehiculoViewModel
            {
                Id = p.Id,
                Nombre = p.Nombre,
                Tipo = p.Tipo.GetDisplayName()
            }).ToList();
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"Error: No se pudieron cargar las partes del vehículo: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowEditar(int id)
    {
        ParteSel = id;
        _modalEditarVisible = true;
    }
}
