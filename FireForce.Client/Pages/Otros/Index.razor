@using FireForce.Client.Helpers;
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager navigationManager
@page "/fire-force/"

@attribute [Authorize(Roles = "administrador,secretaria")]

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<!-- Skip link para accesibilidad con teclado -->
<a href="#main-content" class="abm-skip-link">Saltar al contenido principal</a>

<div class="abm-page abm-page--dashboard" role="main" id="main-content">

    <!-- ========================================
         SECCIÓN BANNER / HERO
         Banner principal con información institucional
         ======================================== -->
    <section aria-labelledby="banner-title" class="banner-section">
        <Row>
            <AntDesign.Col Span="24">
                <Card Bordered="false" Class="banner-card">
                    <img src="Imagenes/banner_index.png" class="banner-image" alt="Banner de Bomberos Voluntarios de Chivilcoy" />
                    <div class="banner-overlay">
                        <div class="banner-content">
                            <Title id="banner-title" Level="1" Class="banner-title">
                                SISTEMA DE GESTIÓN DE BOMBEROS
                            </Title>
                            <Title Level="2" Class="banner-subtitle">
                                Bomberos Voluntarios de Chivilcoy
                            </Title>
                        </div>
                    </div>
                </Card>
            </AntDesign.Col>
        </Row>
    </section>

    <!-- ========================================
         SECCIÓN PRINCIPAL DE NAVEGACIÓN
         Grid responsivo con todas las funcionalidades
         ======================================== -->
    <section aria-label="Menú principal de navegación">
        <Row Gutter="24" Class="dashboard-grid">

            <!-- LEGAJO: Información personal del usuario -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToLegajo"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToLegajo))"
                             role="button"
                             tabindex="0"
                             aria-label="Ir a Legajo Personal"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card legajo-card" Hoverable>
                                <i class="fa-solid fa-user card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">LEGAJO</Title>
                                <Paragraph Class="card-description">
                                    Consulte su información personal y trayectoria
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- SALIDAS: Gestión de emergencias y servicios -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToSalidas"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToSalidas))"
                             role="button"
                             tabindex="0"
                             aria-label="Ir a Salidas y Emergencias"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card salidas-card" Hoverable>
                                <i class="fa fa-house-fire card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">SALIDAS</Title>
                                <Paragraph Class="card-description">
                                    Registre y consulte emergencias atendidas
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- BOMBEROS: Listado del personal activo -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToBomberos"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToBomberos))"
                             role="button"
                             tabindex="0"
                             aria-label="Ver Personal de Bomberos"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card personal-card" Hoverable>
                                <i class="fa-solid fa-people-group card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">BOMBEROS</Title>
                                <Paragraph Class="card-description">
                                    Directorio completo del cuerpo de bomberos
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- COMISIÓN DIRECTIVA: Autoridades institucionales -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToComision"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToComision))"
                             role="button"
                             tabindex="0"
                             aria-label="Ver Comisión Directiva"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card comision-card" Hoverable>
                                <i class="fa-solid fa-user-tie card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">COMISIÓN DIRECTIVA</Title>
                                <Paragraph Class="card-description">
                                    Autoridades y estructura organizativa
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- LICENCIAS: Gestión de ausencias -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToLicencias"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToLicencias))"
                             role="button"
                             tabindex="0"
                             aria-label="Ir a Licencias"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card licencias-card" Hoverable>
                                <i class="fa-solid fa-file-signature card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">LICENCIAS</Title>
                                <Paragraph Class="card-description">
                                    Solicite y gestione licencias del personal
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- UNIDADES: Vehículos y equipamiento -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToUnidades"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToUnidades))"
                             role="button"
                             tabindex="0"
                             aria-label="Ver Unidades y Vehículos"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card unidades-card" Hoverable>
                                <i class="fa-solid fa-truck card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">UNIDADES</Title>
                                <Paragraph Class="card-description">
                                    Flota de vehículos y estado operativo
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- INCIDENTES: Novedades y firmas -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToIncidentes"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToIncidentes))"
                             role="button"
                             tabindex="0"
                             aria-label="Ver Incidentes"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card incidentes-card" Hoverable>
                                <i class="fa-solid fa-clipboard-list card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">INCIDENTES</Title>
                                <Paragraph Class="card-description">
                                    Novedades y firmas de móviles y dependencias
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- ÉTICA: Disciplina y reconocimientos -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <Card Class="dashboard-card etica-card multi-action-card" Hoverable>
                            <i class="fa-solid fa-balance-scale card-icon" aria-hidden="true"></i>
                            <Title Level="3" Class="card-title">ÉTICA</Title>
                            <Paragraph Class="card-description">
                                Tribunal de ética y disciplina
                            </Paragraph>
                            <div class="action-buttons-container" role="group" aria-label="Opciones de Ética">
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToSancionados"
                                        AriaLabel="Ver Sancionados">
                                    <i class="fa-solid fa-user-xmark" aria-hidden="true"></i>
                                    <span>Sancionados</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToAscensos"
                                        AriaLabel="Ver Ascensos">
                                    <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                                    <span>Ascensos</span>
                                </Button>
                            </div>
                        </Card>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- REPORTES: Informes y estadísticas -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <Card Class="dashboard-card reportes-card multi-action-card" Hoverable>
                            <i class="fa-solid fa-chart-line card-icon" aria-hidden="true"></i>
                            <Title Level="3" Class="card-title">REPORTES</Title>
                            <Paragraph Class="card-description">
                                Informes y estadísticas del cuartel
                            </Paragraph>
                            <div class="action-buttons-container" role="group" aria-label="Tipos de Reportes">
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToHistorialBomberos"
                                        AriaLabel="Ver Historial de Bomberos">
                                    <i class="fa-solid fa-user-clock" aria-hidden="true"></i>
                                    <span>Bomberos</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToChoferes"
                                        AriaLabel="Ver Reporte de Choferes">
                                    <i class="fa-solid fa-id-card" aria-hidden="true"></i>
                                    <span>Choferes</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToHistorialMoviles"
                                        AriaLabel="Ver Historial de Móviles">
                                    <i class="fa-solid fa-truck" aria-hidden="true"></i>
                                    <span>Móviles</span>
                                </Button>
                            </div>
                        </Card>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- UTILIDADES: Herramientas y recursos -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <Card Class="dashboard-card utilidades-card multi-action-card" Hoverable>
                            <i class="fa-solid fa-toolbox card-icon" aria-hidden="true"></i>
                            <Title Level="3" Class="card-title">UTILIDADES</Title>
                            <Paragraph Class="card-description">
                                Herramientas y recursos operativos
                            </Paragraph>
                            <div class="action-buttons-container" role="group" aria-label="Herramientas Disponibles">
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToComunicacion"
                                        AriaLabel="Ir a Comunicación">
                                    <i class="fa-solid fa-walkie-talkie" aria-hidden="true"></i>
                                    <span>Comunicación</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToDeposito"
                                        AriaLabel="Ir a Depósito">
                                    <i class="fa-solid fa-warehouse" aria-hidden="true"></i>
                                    <span>Depósito</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToDependencias"
                                        AriaLabel="Ir a Dependencias">
                                    <i class="fa-solid fa-building" aria-hidden="true"></i>
                                    <span>Dependencias</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToFuerzas"
                                        AriaLabel="Ir a Fuerzas Intervinientes">
                                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                                    <span>Fuerzas</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToBrigadas"
                                        AriaLabel="Ir a Brigadas">
                                    <i class="fa-solid fa-users-gear" aria-hidden="true"></i>
                                    <span>Brigadas</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToEquipos"
                                        AriaLabel="Ir a Equipos Autónomos">
                                    <i class="fa-solid fa-lungs" aria-hidden="true"></i>
                                    <span>Equipos</span>
                                </Button>
                                <Button Type="ButtonType.Default"
                                        Class="action-button"
                                        OnClick="NavigateToPartesVehiculos"
                                        AriaLabel="Ir a Partes de Vehículos">
                                    <i class="fa-solid fa-car-side" aria-hidden="true"></i>
                                    <span>Partes</span>
                                </Button>
                            </div>
                        </Card>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- COBRADORES: Personal de recaudación -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToCobradores"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToCobradores))"
                             role="button"
                             tabindex="0"
                             aria-label="Ver Personal de Cobradores"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card cobradores-card" Hoverable>
                                <i class="fa-solid fa-money-bill-wave card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">COBRADORES</Title>
                                <Paragraph Class="card-description">
                                    Personal de recaudación y finanzas
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- SOCIOS: Membresía y asociados -->
            <AuthorizeView Roles="administrador,secretaria">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToSocios"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToSocios))"
                             role="button"
                             tabindex="0"
                             aria-label="Ir a Gestión de Socios"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card socios-card" Hoverable>
                                <i class="fa-solid fa-handshake card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">SOCIOS</Title>
                                <Paragraph Class="card-description">
                                    Administre la base de socios activos
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- COBRANZA: Gestión de cobros en efectivo -->
            <AuthorizeView Roles="administrador">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToCobranza"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToCobranza))"
                             role="button"
                             tabindex="0"
                             aria-label="Ir a Gestión de Cobranza"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card cobranza-card" Hoverable>
                                <i class="fa-solid fa-hand-holding-dollar card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">COBRANZA</Title>
                                <Paragraph Class="card-description">
                                    Gestione los cobros en efectivo a domicilio
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

            <!-- PAGOS: Administración de pagos de socios -->
            <AuthorizeView Roles="administrador,secretaria">
                <Authorized>
                    <AntDesign.Col Xs="24" Sm="12" Lg="8">
                        <div @onclick="NavigateToPagos"
                             @onkeypress="@((e) => HandleKeyPress(e, NavigateToPagos))"
                             role="button"
                             tabindex="0"
                             aria-label="Ir a Administración de Pagos"
                             style="cursor: pointer; height: 100%;">
                            <Card Class="dashboard-card pagos-card" Hoverable>
                                <i class="fa-solid fa-file-invoice-dollar card-icon" aria-hidden="true"></i>
                                <Title Level="3" Class="card-title">PAGOS</Title>
                                <Paragraph Class="card-description">
                                    Administre los pagos y cuotas de socios
                                </Paragraph>
                            </Card>
                        </div>
                    </AntDesign.Col>
                </Authorized>
            </AuthorizeView>

        </Row>
    </section>

    <!-- ========================================
         SECCIÓN CERRAR SESIÓN
         Diseño moderno con gradiente rojo
         ======================================== -->
    <section class="logout-section" aria-label="Cerrar sesión">
        <div class="logout-container">
            <Button Class="logout-button"
                    OnClick="CerrarSesion"
                    Size="ButtonSize.Large"
                    AriaLabel="Cerrar sesión y salir del sistema">
                <Icon Type="logout" Style="margin-right: 0.5rem;" />
                Cerrar Sesión
            </Button>
        </div>
    </section>
</div>

@code {
    // ========================================
    // MÉTODOS DE NAVEGACIÓN
    // Centraliza la lógica de navegación
    // ========================================

    private void NavigateToLegajo() => navigationManager.NavigateTo("/fire-force/Bomberos/Legajo");
    private void NavigateToSalidas() => navigationManager.NavigateTo("/fire-force/Salidas");
    private void NavigateToBomberos() => navigationManager.NavigateTo("/fire-force/personal/bomberos");
    private void NavigateToComision() => navigationManager.NavigateTo("/fire-force/personal/comisiondirectiva");
    private void NavigateToLicencias() => navigationManager.NavigateTo("/fire-force/Licencias");
    private void NavigateToUnidades() => navigationManager.NavigateTo("/fire-force/unidades");
    private void NavigateToIncidentes() => navigationManager.NavigateTo("/fire-force/incidentes");
    private void NavigateToCobradores() => navigationManager.NavigateTo("/fire-force/personal/cobradores");
    private void NavigateToSocios() => navigationManager.NavigateTo("/fire-force/socios");
    private void NavigateToCobranza() => navigationManager.NavigateTo("/fire-force/socios/cobranza"); // Ajustar URL
    private void NavigateToPagos() => navigationManager.NavigateTo("/fire-force/socios/pagos"); // Ajustar URL

    // Ética
    private void NavigateToSancionados() => navigationManager.NavigateTo("/fire-force/bomberos/sancionados");
    private void NavigateToAscensos() => navigationManager.NavigateTo("/fire-force/bomberos/ascenso");

    // Reportes
    private void NavigateToHistorialBomberos() => navigationManager.NavigateTo("/fire-force/Reportes/HistorialBomberos");
    private void NavigateToChoferes() => navigationManager.NavigateTo("/fire-force/Reportes/Reportes_Choferes");
    private void NavigateToHistorialMoviles() => navigationManager.NavigateTo("/fire-force/Reportes/HistorialMoviles");

    // Utilidades
    private void NavigateToComunicacion() => navigationManager.NavigateTo("/fire-force/Dependencias/Comunicacion");
    private void NavigateToDeposito() => navigationManager.NavigateTo("/fire-force/Dependencias/Deposito");
    private void NavigateToDependencias() => navigationManager.NavigateTo("/fire-force/Dependencias");
    private void NavigateToFuerzas() => navigationManager.NavigateTo("/fire-force/FuerzasIntervinientes");
    private void NavigateToBrigadas() => navigationManager.NavigateTo("/fire-force/Brigadas");
    private void NavigateToEquipos() => navigationManager.NavigateTo("/fire-force/Dependencias/EquiposAutonomos");
    private void NavigateToPartesVehiculos() => navigationManager.NavigateTo("/fire-force/partes-vehiculos");

    // ========================================
    // CERRAR SESIÓN
    // Cierra la sesión del usuario
    // ========================================
    private void CerrarSesion()
    {
        navigationManager.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
    }

    // ========================================
    // ACCESIBILIDAD: Soporte para teclado
    // Permite navegar con Enter o Espacio
    // ========================================
    private void HandleKeyPress(KeyboardEventArgs e, Action navigationAction)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            navigationAction?.Invoke();
        }
    }
}
