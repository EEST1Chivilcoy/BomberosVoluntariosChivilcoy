@page "/fire-force/Dependencias"
@using FireForce.Data.Models.Grupos.Dependencias
@using FireForce.Client.Data.ViewModels.Personal
@using FireForce.Data.Models.Personas.Personal
@using FireForce.Data.Models.Personas.Personal.Componentes
@using FireForce.Client.Data.Mappers

@*Servicios Utilizados*@
@using FireForce.Client.Services
@inject IDependenciaService DependenciaService
@inject IBomberoService BomberoService
@inject IMessageService MessageService

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AdminOnly")]

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@


<div class="abm-page abm-page--titulo-acciones abm-page--dependencias">
    <div class="abm-container">
        <Card Class="abm-main-card">
            <div class="abm-header-section">
                <div class="lava-bubbles">
                    <div class="lava-bubble b1"></div>
                    <div class="lava-bubble b2"></div>
                    <div class="lava-bubble b3"></div>
                    <div class="lava-bubble b4"></div>
                    <div class="lava-bubble b5"></div>
                </div>
                <div class="title-container">
                    <h1 class="main-title">
                        <Icon Type="team" Class="title-icon" />
                        DEPENDENCIAS
                    </h1>
                </div>
                <div class="actions-row">
                    <Button Class="modern-button add-button"
                            OnClick="() => VerAñadirDependencia()"
                            Icon="plus"
                            Size="ButtonSize.Large">
                        Nueva Dependencia
                    </Button>
                </div>
            </div>
            <div class="abm-table-container">
                <Table DataSource="@DependenciaViewModels"
                       PageSize="@_pageSize"
                       Responsive
                       TItem="DependenciaViewModelTable"
                       ScrollX="800px">
                    <ColumnDefinitions Context="dependencia">
                        <PropertyColumn Title="👤 Nombre"
                                        Property="d => d.Nombre"
                                        Sortable
                                        Width="250px"
                                        Fixed="ColumnFixPlacement.Left" />

                        <PropertyColumn Title="🧑‍💼 Encargado"
                                        Property="d => d.EncargadoApellidoYNombre"
                                        Sortable
                                        Width="200px" />

                        <ActionColumn Title="⚙️ Acciones"
                                      Align=ColumnAlign.Center
                                      Width="180px"
                                      Fixed="ColumnFixPlacement.Right">
                            <Space>
                                <SpaceItem>
                                    <Button OnClick="() => VerDetalleDependencia(dependencia.Id)">
                                        <Icon Type="team" />
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Popconfirm Title="¿Eliminar esta dependencia?"
                                                OnConfirm="() => BorrarDependencia(dependencia.Id)"
                                                OkText="Si"
                                                CancelText="No">
                                        <Button Danger>
                                            <Icon Type="delete" />
                                        </Button>
                                    </Popconfirm>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button Type="@ButtonType.Primary"
                                            OnClick="() => VerEditarDependencia(dependencia.Id)"
                                            Ghost>
                                        <Icon Type="edit" />
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ColumnDefinitions>
                </Table>
            </div>
        </Card>
    </div>
</div>

@*Modal para Añadir Dependencias con diseño de Dependencias*@
<Modal Footer="null" Visible="_modalAgregarVisible"
       Title="Añadir Dependencia"
       Width="@("100%")"
       Style="max-width: 800px;"
       OnCancel="CerrarAgregar"
       DestroyOnClose
       Centered
       WrapClassName="modal-abm modal-crear-dependencia">
    <div class="modal-content-abm">
        <Form OnFinish="AddDependencia" Model="newDependencia" Layout="FormLayout.Vertical">
            <Row Gutter="16">
                <AntDesign.Col Span="16">
                    <FormItem Label="Nombre" Required Class="modal-form-item-abm">
                        <Input @bind-Value="newDependencia.Nombre" Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
                <AntDesign.Col Span="8">
                    <FormItem Label="Encargado" Required Class="modal-form-item-abm">
                        <Select TItem="BomberoViweModel"
                                TItemValue="BomberoViweModel"
                                DataSource="@bomberosTodosViewModel"
                                @bind-Value="newDependencia.Encargado"
                                LabelName="@nameof(BomberoViweModel.ApellidoYNombre)"
                                Placeholder="Seleccione un bombero"
                                DefaultActiveFirstOption="false"
                                AllowClear="true"
                                EnableSearch
                                Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
            </Row>
            <div class="modal-footer-abm">
                <Button Class="boton-agregar" HtmlType="submit">
                    Agregar
                </Button>
            </div>
        </Form>
    </div>
</Modal>

@*Modal para Editar Dependencias con diseño de Dependencias*@
<Modal Footer="null" Visible="_modalEditarVisible"
       Title="Editar Dependencia"
       Width="@("100%")"
       Style="max-width: 800px;"
       OnCancel="CerrarEditar"
       DestroyOnClose
       Centered
       WrapClassName="modal-abm modal-crear-dependencia">
    <div class="modal-content-abm">
        <Form OnFinish="EditDependencia" Model="selDependencia" Layout="FormLayout.Vertical">
            <Row Gutter="16">
                <AntDesign.Col Span="16">
                    <FormItem Label="Nombre" Required Class="modal-form-item-abm">
                        <Input @bind-Value="selDependencia.Nombre" Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
                <AntDesign.Col Span="8">
                    <FormItem Label="Encargado" Required Class="modal-form-item-abm">
                        <Select TItem="BomberoViweModel"
                                TItemValue="BomberoViweModel"
                                DataSource="@bomberosTodosViewModel"
                                @bind-Value="selDependencia.Encargado"
                                LabelName="@nameof(BomberoViweModel.ApellidoYNombre)"
                                Placeholder="Seleccione un bombero"
                                DefaultActiveFirstOption="false"
                                AllowClear="true"
                                EnableSearch
                                Size="InputSize.Large" />
                    </FormItem>
                </AntDesign.Col>
            </Row>
            <div class="modal-footer-abm">
                <Button Class="boton-agregar" HtmlType="submit">
                    Editar
                </Button>
            </div>
        </Form>
    </div>
</Modal>

@if (_modalDetallesVisible)
{
    <BomberosDependencia DependenciaId="@IdDependenciaSel" ExternalVisible="_modalDetallesVisible" OnClose="() => _modalDetallesVisible = false"></BomberosDependencia>
}

@code {
    // Lista con todos los bomberos
    private List<Bombero> bomberosTodos = new();

    // Lista con todos los bomberos en formato ViewModel
    private List<BomberoViweModel> bomberosTodosViewModel = new();

    // Variables
    private DependenciaViewModelTable newDependencia = new();
    private DependenciaViewModelTable selDependencia = new();
    private string? TitleDependenciaSel;
    private int IdDependenciaSel;

    // Modals
    private bool _modalAgregarVisible = false;
    private bool _modalDetallesVisible = false;
    private bool _modalEditarVisible = false;

    // Lista de Dependencias
    private List<Dependencia> Dependencias = new List<Dependencia>();

    // Variables de Tamaño de la Tabla
    int _pageIndex = 1;
    int _pageSize = 5;


    // Lista de ViewModels de Dependencia
    private List<DependenciaViewModelTable> DependenciaViewModels = new List<DependenciaViewModelTable>();

    public class DependenciaViewModelTable
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = null!;
        public string? EncargadoApellidoYNombre { get; set; }
        public BomberoViweModel Encargado { get; set; } = null!;
    }

    protected override async Task OnInitializedAsync()
    {
        bomberosTodos = await BomberoService.ObtenerTodosLosBomberosAsync() ?? new();
        bomberosTodosViewModel = bomberosTodos.ToBomberoViewModelList() ?? new List<BomberoViweModel>();
        await CargarDependencias();
    }

    private async Task CargarDependencias()
    {
        Dependencias = await DependenciaService.ObtenerTodasLasDependenciasAsync() ?? new();

        // Reconstruir SIEMPRE el listado mapeado (si se corta antes, la tabla
        // retiene filas viejas al borrar la última dependencia). Una base sin
        // dependencias es un estado normal: la tabla muestra "No hay datos".
        DependenciaViewModels = Dependencias.Select(d => new DependenciaViewModelTable
        {
            Id = d.DependenciaId,
            Nombre = d.NombreDependencia,
            EncargadoApellidoYNombre = d.Encargado != null
                ? $"{d.Encargado.Apellido}, {d.Encargado.Nombre}"
                : "Sin Encargado"
        }).ToList();
    }

    private async Task AddDependencia()
    {
        if (newDependencia.Encargado?.NumeroLegajo is not int legajo)
        {
            MessageService.Error("No se ha seleccionado un encargado. Por favor, elija un encargado antes de continuar.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newDependencia.Nombre))
        {
            MessageService.Error("El nombre de la dependencia no puede estar vacío.");
            return;
        }

        try
        {
            Bombero BomberoEncargado = await BomberoService.ObtenerBomberoObjetoPorLegajoAsync(legajo);
            if (BomberoEncargado == null)
            {
                MessageService.Error("El encargado seleccionado no es válido.");
                return;
            }

            var dependencia = new Dependencia
            {
                NombreDependencia = newDependencia.Nombre,
                Encargado = BomberoEncargado
            };

            await DependenciaService.AgregarDependenciaAsync(dependencia);
        }
        catch (Exception ex)
        {
            MessageService.Error($"No se pudo guardar la dependencia: {ex.Message}");
            return;
        }

        newDependencia = new DependenciaViewModelTable();
        _modalAgregarVisible = false;
        await CargarDependencias();
        MessageService.Success("Dependencia añadida correctamente.");
    }

    private async Task EditDependencia()
    {
        if (selDependencia.Encargado?.NumeroLegajo is not int legajo)
        {
            MessageService.Error("No se ha seleccionado un encargado. Por favor, elija un encargado antes de continuar.");
            return;
        }

        if (string.IsNullOrWhiteSpace(selDependencia.Nombre))
        {
            MessageService.Error("El nombre de la dependencia no puede estar vacío.");
            return;
        }

        if (selDependencia.Id <= 0)
        {
            MessageService.Error("ID inválido. Por favor, proporcione un ID válido.");
            return;
        }

        try
        {
            var BomberoEncargado = await BomberoService.ObtenerBomberoObjetoPorLegajoAsync(legajo);
            if (BomberoEncargado == null)
            {
                MessageService.Error("El encargado seleccionado no es válido.");
                return;
            }

            var dependencia = new Dependencia
            {
                DependenciaId = selDependencia.Id,
                NombreDependencia = selDependencia.Nombre,
                Encargado = BomberoEncargado
            };

            await DependenciaService.EditarDependenciaAsync(dependencia);
        }
        catch (Exception ex)
        {
            MessageService.Error($"No se pudo editar la dependencia: {ex.Message}");
            return;
        }

        _modalEditarVisible = false;
        await CargarDependencias();
        MessageService.Success("Dependencia editada correctamente.");
    }

    private void VerAñadirDependencia()
    {
        if (bomberosTodos.Count == 0)
        {
            MessageService.Error("No hay bomberos disponibles para asignar como encargado.");
            return;
        }

        newDependencia = new DependenciaViewModelTable();
        _modalAgregarVisible = true;
    }

    private async Task VerEditarDependencia(int id)
    {
        if (id <= 0)
        {
            MessageService.Error("ID inválido. Por favor, proporcione un ID válido.");
            return;
        }

        var Dependencia = await DependenciaService.ObtenerDependenciaPorIdAsync(id);

        if (Dependencia == null)
        {
            MessageService.Error("Error al intentar editar la dependencia: No se encontró.");
            return;
        }

        var encargado = bomberosTodosViewModel.FirstOrDefault(b => b.NumeroLegajo == Dependencia.Encargado?.NumeroLegajo);

        if (encargado == null)
        {
            MessageService.Error("Error al intentar editar la dependencia: No se encontró un encargado válido.");
            return;
        }

        selDependencia = new DependenciaViewModelTable
        {
            Id = Dependencia.DependenciaId,
            Nombre = Dependencia.NombreDependencia,
            Encargado = encargado
        };

        _modalEditarVisible = true;
    }

    private async Task VerDetalleDependencia(int id)
    {
        var Dependencia = await DependenciaService.ObtenerDependenciaPorIdAsync(id);
        if (Dependencia != null!)
        {
            TitleDependenciaSel = Dependencia.NombreDependencia;
            IdDependenciaSel = Dependencia.DependenciaId;
            _modalDetallesVisible = true;
        }
        else
            MessageService.Error("Error al abrir la dependencia: No se encontró.");
    }

    private async Task BorrarDependencia(int id)
    {
        try
        {
            await DependenciaService.EliminarDependenciaAsync(id);
        }
        catch (Exception ex)
        {
            MessageService.Error($"No se pudo eliminar la dependencia: {ex.Message}");
            return;
        }

        await CargarDependencias();
        MessageService.Success("Dependencia eliminada correctamente.");
    }

    private void CerrarAgregar()
    {
        _modalAgregarVisible = false;
    }

    private void CerrarEditar()
    {
        _modalEditarVisible = false;
    }
}