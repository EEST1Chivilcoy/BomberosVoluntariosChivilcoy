@using FireForce.Shared.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using FireForce.Data.Models.Grupos.Dependencias
@using FireForce.Data.Models.Grupos.Dependencias.EquiposAutonomos
@using FireForce.Data.Models.Vehiculos.Flota
@using FireForce.Client.Services
@using FireForce.Shared.Enums
@using Microsoft.Identity.Web
@using Microsoft.Graph

@attribute [Authorize]

@*Servicios Utilizados*@
@inject NavigationManager navigationManager
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject IEntraIDService EntraIDService
@inject IMessageService message
@inject IEquipoAutonomoService EquipoAutonomoService
@inject IMovimientoEquipoAutonomoService MovimientoEquipoAutonomoService
@inject IBomberoService BomberoService
@inject IDependenciaService DependenciaService
@inject IVehiculoSalidaService VehiculoSalidaService

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@


<Form Loading="loading"
      Model="@movimientoViewModel"
      Layout="FormLayout.Vertical"
      Class="modal-crear-equipo-form"
      OnFinish="OnFinish"
      OnFinishFailed="OnFinishFailed">

    @if (equipoActual?.Estado == TipoEstadoEquipoAutonomo.PruebaHidraulica)
    {
        <div class="alerta-prueba-hidraulica">
            <span class="icon">⚠️</span>
            <span><strong>Atención:</strong> El equipo está en Prueba Hidráulica. Solo puede darse de baja o devolverse al stock.</span>
        </div>
    }

    <Row Class="modal-crear-equipo-row" Gutter="16">
        <AntDesign.Col Span="12">
            <FormItem Label="↔️ Tipo Movimiento" Class="modal-crear-equipo-form-item">
                @if (equipoActual?.Estado == TipoEstadoEquipoAutonomo.PruebaHidraulica)
                {
                    <Select TItem="TipoMovimientoViewModel"
                            TItemValue="TipoMovimiento"
                            DataSource="@tiposMovimientoPermitidos"
                            @bind-Value="@movimientoViewModel.TipoMovimiento"
                            LabelName="@nameof(TipoMovimientoViewModel.Nombre)"
                            ValueName="@nameof(TipoMovimientoViewModel.Valor)"
                            Placeholder="Seleccione el tipo de movimiento"
                            AllowClear="true"
                            Size="InputSize.Large" />
                }
                else
                {
                    <EnumSelect TEnum="TipoMovimiento"
                                @bind-Value="@movimientoViewModel.TipoMovimiento"
                                Placeholder="Seleccione el tipo de movimiento"
                                AllowClear="true"
                                Size="InputSize.Large" />
                }
            </FormItem>
        </AntDesign.Col>

        @if (movimientoViewModel.TipoMovimiento == TipoMovimiento.Asignar ||
                movimientoViewModel.TipoMovimiento == TipoMovimiento.Reparar ||
                movimientoViewModel.TipoMovimiento == TipoMovimiento.Prueba)
        {
            <AntDesign.Col Span="12">
                <FormItem Label="📍 Tipo Destino" Class="modal-crear-equipo-form-item">
                    <RadioGroup @bind-Value="@_valueSel">
                        <Radio Value="1">Dependencia</Radio>
                        <Radio Value="2">Unidad</Radio>
                        <Radio Value="3">Otro</Radio>
                    </RadioGroup>
                </FormItem>
            </AntDesign.Col>
        }
        else if (movimientoViewModel.TipoMovimiento == TipoMovimiento.DevolverAlStock && equipoActual?.Estado == TipoEstadoEquipoAutonomo.PruebaHidraulica)
        {
            <AntDesign.Col Span="12">
                <FormItem Label="📅 Fecha de vencimiento de la prueba hidráulica"
                          Class="modal-crear-equipo-form-item">
                    <DatePicker Mask="dd/MM/yyyy" @bind-Value="@movimientoViewModel.FechaVencimientoPruebaHidraulica"
                                Size="InputSize.Large"
                                Placeholder=@("Seleccione la fecha de vencimiento") />
                </FormItem>
            </AntDesign.Col>
        }
    </Row>

    @if (movimientoViewModel.TipoMovimiento == TipoMovimiento.Asignar ||
        movimientoViewModel.TipoMovimiento == TipoMovimiento.Reparar ||
        movimientoViewModel.TipoMovimiento == TipoMovimiento.Prueba)
    {
        <Row Class="modal-crear-equipo-row" Gutter="16">
            <AntDesign.Col Span="12">
                <FormItem Label="📍 Destino" Class="modal-crear-equipo-form-item">
                    @if (_valueSel == 1)
                    {
                        <Select TItem="DependenciaViewModel"
                                TItemValue="DependenciaViewModel"
                                DataSource="@dependenciaViewModels"
                                @bind-value="@movimientoViewModel.DependenciaDestino"
                                LabelName="@nameof(DependenciaViewModel.Nombre)"
                                Placeholder="Seleccione una dependencia"
                                EnableSearch
                                AllowClear="true"
                                Size="InputSize.Large" />
                    }
                    else if (_valueSel == 2)
                    {
                        <Select TItem="UnidadViewModel"
                                TItemValue="UnidadViewModel"
                                DataSource="@unidadViewModels"
                                @bind-value="@movimientoViewModel.UnidadDestino"
                                LabelName="@nameof(UnidadViewModel.Nombre)"
                                Placeholder="Seleccione una unidad"
                                EnableSearch
                                AllowClear="true"
                                Size="InputSize.Large" />
                    }
                    else if (_valueSel == 3)
                    {
                        <Input @bind-Value="@movimientoViewModel.OtroDestino"
                               Placeholder="Ingrese otro destino"
                               Size="InputSize.Large" />
                    }
                </FormItem>
            </AntDesign.Col>
        </Row>
    }

    <div class="modal-footer-abm">
        <Button Type="@ButtonType.Primary" HtmlType="submit">
            Agregar Movimiento
        </Button>
    </div>

</Form>



@code {
    [Parameter] public EventCallback OnFinishCallback { get; set; }
    [Parameter] public int EquipoIDSel { get; set; }

    private bool loading = false;
    private int _valueSel = 0;
    private EquipoAutonomoMovimientoViewModel movimientoViewModel = new EquipoAutonomoMovimientoViewModel();
    private EquipoAutonomo? equipoActual = null;
    private List<TipoMovimientoViewModel> tiposMovimientoPermitidos = new();

    List<DependenciaViewModel?> dependenciaViewModels = new();
    List<UnidadViewModel?> unidadViewModels = new();

    private class EquipoAutonomoMovimientoViewModel
    {
        public TipoMovimiento TipoMovimiento;

        public DependenciaViewModel? DependenciaDestino;

        public UnidadViewModel? UnidadDestino;

        public DateTime? FechaVencimientoPruebaHidraulica { get; set; }

        public string? OtroDestino;
    }

    private enum TipoMovimiento
    {
        [Display(Name = "Dar de Baja")]
        DarDeBaja = 1,

        [Display(Name = "Asignar")]
        Asignar = 2,

        [Display(Name = "Devolver al Stock")]
        DevolverAlStock = 3,

        [Display(Name = "Reparación")]
        Reparar = 4,

        [Display(Name = "Prueba Hidráulica")]
        Prueba = 5
    }

    private class TipoMovimientoViewModel
    {
        public TipoMovimiento Valor { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    private class DependenciaViewModel
    {
        public int DependenciaId { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    private class UnidadViewModel
    {
        public int UnidadId { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    private async Task OnFinish(EditContext editContext)
    {
        // Validar que el equipo esté cargado
        if (equipoActual == null)
        {
            await message.ErrorAsync("Error: No se pudo cargar la información del equipo.");
            return;
        }

        // Validación: Si el equipo está en Prueba Hidráulica, solo permite Baja o Stock
        if (equipoActual.Estado == TipoEstadoEquipoAutonomo.PruebaHidraulica)
        {
            if (movimientoViewModel.TipoMovimiento != TipoMovimiento.DarDeBaja &&
                movimientoViewModel.TipoMovimiento != TipoMovimiento.DevolverAlStock)
            {
                await message.ErrorAsync("Error: El equipo está en Prueba Hidráulica. Solo puede darse de baja o devolverse al stock.");
                return;
            }
        }

        // Validaciones todas piola
        if (movimientoViewModel.TipoMovimiento == TipoMovimiento.Asignar ||
                                movimientoViewModel.TipoMovimiento == TipoMovimiento.Reparar ||
                                movimientoViewModel.TipoMovimiento == TipoMovimiento.Prueba)
        {
            if (_valueSel == 1 && movimientoViewModel.DependenciaDestino == null)
            {
                await message.ErrorAsync("Error: Debe seleccionar una dependencia de destino.");
                return;
            }
            else if (_valueSel == 2 && movimientoViewModel.UnidadDestino == null)
            {
                await message.ErrorAsync("Error: Debe seleccionar una unidad de destino.");
                return;
            }
            else if (_valueSel == 3 && string.IsNullOrWhiteSpace(movimientoViewModel.OtroDestino))
            {
                await message.ErrorAsync("Error: Debe ingresar un destino.");
                return;
            }
        }

        // Validación especial para devolución al stock con fecha de prueba hidráulica
        if (movimientoViewModel.TipoMovimiento == TipoMovimiento.DevolverAlStock &&
            equipoActual.Estado == TipoEstadoEquipoAutonomo.PruebaHidraulica)
        {
            if (movimientoViewModel.FechaVencimientoPruebaHidraulica == null)
            {
                await message.ErrorAsync("Error: Debe ingresar la fecha de vencimiento de la prueba hidráulica al devolver al stock.");
                return;
            }
        }

        TipoMovimiento tipoMovimientoSeleccionado = movimientoViewModel.TipoMovimiento;

        TipoEstadoEquipoAutonomo estadoEquipoAutonomo = tipoMovimientoSeleccionado switch
        {
            TipoMovimiento.Asignar => TipoEstadoEquipoAutonomo.Activo,
            TipoMovimiento.DarDeBaja => TipoEstadoEquipoAutonomo.Baja,
            TipoMovimiento.DevolverAlStock => TipoEstadoEquipoAutonomo.Stock,
            TipoMovimiento.Reparar => TipoEstadoEquipoAutonomo.Reparacion,
            TipoMovimiento.Prueba => TipoEstadoEquipoAutonomo.PruebaHidraulica,

            _ => throw new ArgumentOutOfRangeException(nameof(tipoMovimientoSeleccionado), "Tipo de movimiento no tiene un estado correspondiente.")
        };

        loading = true;

        try
        {
            var encargadoId = await GetIdEncargado();

            if (encargadoId == null)
            {
                throw new Exception("No se pudo obtener el ID del encargado para el movimiento.");
            }

            var movimiento = new Movimiento_EquipoAutonomo
            {
                EquipoAutonomoId = EquipoIDSel,
                EncargadoId = encargadoId.Value,
                EstadoNuevo = estadoEquipoAutonomo,
                DependenciaDestinoId = movimientoViewModel.DependenciaDestino?.DependenciaId,
                VehiculoDestinoId = movimientoViewModel.UnidadDestino?.UnidadId,
                FechaVencimientoPruebaHidraulica = movimientoViewModel.FechaVencimientoPruebaHidraulica,
                OtroDestino = movimientoViewModel.OtroDestino,
            };

            await MovimientoEquipoAutonomoService.CargarMovimientoAsync(movimiento);

            // Mensaje especial cuando se devuelve al stock después de prueba hidráulica
            if (equipoActual.Estado == TipoEstadoEquipoAutonomo.PruebaHidraulica &&
                tipoMovimientoSeleccionado == TipoMovimiento.DevolverAlStock)
            {
                await message.SuccessAsync("Movimiento agregado correctamente. Las fechas de prueba hidráulica han sido actualizadas.");
            }
            else
            {
                await message.SuccessAsync("Movimiento agregado correctamente.");
            }

            movimientoViewModel = new EquipoAutonomoMovimientoViewModel();
            await OnFinishCallback.InvokeAsync();
        }
        catch (Exception ex)
        {
            await message.ErrorAsync($"Error: Se produjo un error al agregar el movimiento.\nDetalles: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFinishFailed(EditContext editContext)
    {
        message.Error("Error en el formulario. Verifique los datos.");
    }

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        try
        {
            var EntraIDisDisponbile = await EntraIDService.CheckDisponibilidadAsync();
            await LoadEquipoAsync();
            CargarTiposMovimientoPermitidos();
            await LoadDependenciasAsync();
            await LoadUnidadesAsync();
        }
        catch (Exception ex)
        {
            ConsentHandler.HandleException(ex);
            await message.ErrorAsync($"Error: Se produjo un error al inicializar el formulario.\nDetalles: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadEquipoAsync()
    {
        equipoActual = await EquipoAutonomoService.ObtenerEquipoAutonomoAsync(EquipoIDSel);

        if (equipoActual == null)
        {
            await message.ErrorAsync($"Error: No se encontró el equipo autónomo con ID {EquipoIDSel}.");
        }
    }

    private void CargarTiposMovimientoPermitidos()
    {
        if (equipoActual?.Estado == TipoEstadoEquipoAutonomo.PruebaHidraulica)
        {
            tiposMovimientoPermitidos = new List<TipoMovimientoViewModel>
            {
                new TipoMovimientoViewModel { Valor = TipoMovimiento.DarDeBaja, Nombre = "Dar de Baja" },
                new TipoMovimientoViewModel { Valor = TipoMovimiento.DevolverAlStock, Nombre = "Devolver al Stock" }
            };
        }
    }

    private async Task LoadDependenciasAsync()
    {
        var dependencias = await DependenciaService.ObtenerTodasLasDependenciasAsync();

        dependenciaViewModels = dependencias.Select(d => new DependenciaViewModel
        {
            DependenciaId = d.DependenciaId,
            Nombre = d.NombreDependencia
        }).ToList();
    }

    private async Task LoadUnidadesAsync()
    {
        var unidades = await VehiculoSalidaService.ObtenerTodosLosVehiculosSalidasAsync();

        unidadViewModels = unidades.Select(u => new UnidadViewModel
        {
            UnidadId = u.VehiculoId,
            Nombre = u.NumeroMovil
        }).ToList();
    }

    private async Task<int?> GetIdEncargado()
    {
        try
        {
            string userIdString = await EntraIDService.GetUserIdAsync();
            Guid userId = Guid.Parse(userIdString);
            var bombero = await BomberoService.ObtenerBomberoPorEntraIdAsync(userId);

            if (bombero != null)
            {
                return bombero.PersonaId;
            }
            else
            {
                await message.ErrorAsync("Error al obtener el ID del responsable: Bombero no encontrado.");
            }
        }
        catch (Exception ex)
        {
            await message.ErrorAsync($"Error al obtener el ID del responsable: {ex.Message}");
            return null;
        }
        return null;
    }
}