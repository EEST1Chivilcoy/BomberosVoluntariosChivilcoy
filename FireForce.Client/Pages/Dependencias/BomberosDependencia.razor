@using FireForce.Data.Models.Grupos.Dependencias
@using FireForce.Client.Data.ViewModels.Personal
@using FireForce.Data.Models.Personas.Personal
@using FireForce.Data.Models.Personas.Personal.Componentes
@using FireForce.Client.Data.Mappers

@*Servicios Utilizados*@
@using FireForce.Client.Services
@inject IDependenciaService DependenciaService
@inject IBomberoService BomberoService
@inject IMessageService MessageService

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<Modal @bind-Visible="ExternalVisible"
	   Title="@DependenciaNombre"
	   Footer="null"
	   Maximizable="@true"
	   Centered
	   Width="800"
	   WrapClassName="modal-abm modal-crear-dependencia"
	   OnCancel="@HandleClose">
	<div class="modal-content-abm">
		@* Alta inline: elegir bomberos y agregarlos sin abrir otro modal encima. *@
		<div class="agregar-bomberos-row">
			<Select Mode="SelectMode.Multiple"
					Placeholder="Elige los bomberos a agregar a la dependencia"
					DataSource="@BomberosParaAgregarViewModel"
					Values="@BomberosSeleccionados"
					TItem="BomberoViweModel"
					TItemValue="int"
					LabelName="@nameof(BomberoViweModel.ApellidoYNombre)"
					ValueName="@nameof(BomberoViweModel.Id)"
					EnableSearch="true"
					ValuesChanged="@(async (values) => await HandleValuesChange(values))" />
			<Button Type="@ButtonType.Primary" OnClick="@AddFirefighterToDepartmentAsync" Disabled="@(!BomberosSeleccionados.Any())">
				<Icon Type="plus" /> Agregar
			</Button>
		</div>

		<Table DataSource="@BomberosViewModel"
			   PageSize="@_pageSize"
			   Responsive
			   TItem="BomberoDependenciaViewModel"
			   Title="Bomberos de la Dependencia">

			<ColumnDefinitions Context="bombero">
				<PropertyColumn Title="N° Legajo"
								Property="d => d.NroLeg"
								Sortable />

				<PropertyColumn Title="Apellido y Nombre"
								Property="d => d.ApellidoYNombre"
								Sortable />

				<ActionColumn Title="Acciones" Align=ColumnAlign.Center>
					<Space>
						<SpaceItem>
							<Popconfirm Title="¿Deseas remover a este bombero de la dependencia?"
										OnConfirm="() => RemoveFirefighterFromDepartment(bombero.Id, DependenciaId)"
										OkText="Si"
										CancelText="No">
								<Button Danger>
									<Icon Type="close" />
								</Button>
							</Popconfirm>
						</SpaceItem>
					</Space>
				</ActionColumn>
			</ColumnDefinitions>
		</Table>
	</div>
</Modal>

@code {
	[Parameter] public int DependenciaId { get; set; } // ID de la Dependencia que se está editando
	[Parameter] public string DependenciaNombre { get; set; } = string.Empty; // Nombre de la Dependencia
	[Parameter] public EventCallback OnClose { get; set; } // Callback para cerrar la vista
	[Parameter] public bool ExternalVisible { get; set; } // Controlador de visibilidad externo
	private List<Bombero?> DependenciaBomberos = new(); // Lista de Bomberos de la Dependencia
	public List<BomberoDependenciaViewModel> BomberosViewModel { get; set; } = new(); // Lista de Bomberos en formato ViewModel para la Dependencia
	private List<int> BomberosSeleccionados = new List<int>(); // Lista de IDs de Bomberos seleccionados para agregar a la Dependencia
	public List<BomberoViweModel> BomberosParaAgregarViewModel { get; set; } = new(); // Lista de Bomberos en formato ViewModel para los Bomberos disponibles para agregar

	// Variables de Tamaño de la Tabla
	int _pageIndex = 1;
	int _pageSize = 10; // Aumentamos el tamaño de página para mejor visualización

	public class BomberoDependenciaViewModel
	{
		public int Id { get; set; }
		public int NroLeg { get; set; }
		public string ApellidoYNombre { get; set; } = null!;
	}

	protected override async Task OnInitializedAsync()
	{
		await OnInit();
	}

	public async Task OnInit()
	{
		if (DependenciaId <= 0)
		{
			MessageService.Error("ID de Dependencia inválido.");
			return;
		}

		var dependencia = await DependenciaService.ObtenerDependenciaPorIdAsync(DependenciaId);
		if (dependencia == null)
		{
			MessageService.Error("No se encontró la dependencia.");
			return;
		}

		DependenciaNombre = dependencia.NombreDependencia;

		var bomberosTodos = await BomberoService.ObtenerTodosLosBomberosAsync() ?? new();

		// Candidatos: todos menos el encargado (si lo hay) y los que ya
		// están en la dependencia.
		var encargadoId = await DependenciaService.ObtenerEncargadoDeDependenciaIdAsync(DependenciaId);
		DependenciaBomberos = await DependenciaService.ObtenerBomberosDeDependenciaAsync(DependenciaId);
		var bomberosParaAgregar = bomberosTodos.Where(b =>
			b.PersonaId != encargadoId &&
			!DependenciaBomberos.Any(db => db?.PersonaId == b.PersonaId)).ToList();
		BomberosParaAgregarViewModel = bomberosParaAgregar.ToBomberoViewModelList();

		BomberosViewModel = MapFirefightersToDepartmentViewModels(DependenciaBomberos)!;
		BomberosSeleccionados = new();
		StateHasChanged();
	}

	public List<BomberoDependenciaViewModel> MapFirefightersToDepartmentViewModels(List<Bombero?> bomberos)
	{
		if (bomberos != null && bomberos.Any())
		{
			List<BomberoDependenciaViewModel> viewModels = new List<BomberoDependenciaViewModel>();

			foreach (var bombero in bomberos)
			{
				if (bombero is null) continue;
				viewModels.Add(new BomberoDependenciaViewModel
				{
					Id = bombero.PersonaId,
					NroLeg = bombero.NumeroLegajo,
					ApellidoYNombre = $"{bombero.Apellido}, {bombero.Nombre}"
				});
			}
			return viewModels;
		}
		return new();
	}

	public async Task RemoveFirefighterFromDepartment(int BomberoID, int DependenciaID)
	{
		if (BomberoID == 0 || DependenciaID == 0)
		{
			MessageService.Error("No se puede eliminar el bombero de la dependencia");
			return;
		}

		try
		{
			bool isBomberoInDependencia = await DependenciaService.ComprobarBomberoEnDependenciaAsync(DependenciaID, BomberoID);
			if (!isBomberoInDependencia)
			{
				MessageService.Error("El bombero no pertenece a la dependencia");
				return;
			}

			await DependenciaService.QuitarBomberoDeDependenciaAsync(DependenciaID, BomberoID);
		}
		catch (Exception ex)
		{
			MessageService.Error(ex.Message);
			return;
		}

		await OnInit();
	}

	public async Task AddFirefighterToDepartmentAsync()
	{
		if (!BomberosSeleccionados.Any())
			return;

		int agregados = 0;
		try
		{
			foreach (int BomberoSelId in BomberosSeleccionados.Where(id => id > 0))
			{
				await DependenciaService.AgregarBomberoADependenciaAsync(DependenciaId, BomberoSelId);
				agregados++;
			}
		}
		catch (Exception ex)
		{
			// Sin este catch, la excepción del servicio (p. ej. "El bombero
			// ya pertenece a la dependencia") tumbaba el circuito de Blazor.
			MessageService.Error(ex.Message);
		}

		await OnInit();
		if (agregados > 0)
			MessageService.Success($"Se añadieron {agregados} bomberos a la dependencia.");
	}

	private async Task HandleValuesChange(IEnumerable<int> values)
	{
		BomberosSeleccionados = values.ToList();
	}

	private async Task HandleClose()
	{
		if (OnClose.HasDelegate)
		{
			await OnClose.InvokeAsync();
		}
	}
}