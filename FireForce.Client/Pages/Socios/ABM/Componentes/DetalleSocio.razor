@using FireForce.Shared.Enums.Socios
@using FireForce.Shared.Enums.Discriminadores
@using FireForce.Data.Models.Socios

@*Servicios Utilizados*@
@using FireForce.Client.Services
@inject NavigationManager navigationManager
@inject ISocioService SocioService
@inject IMessageService message

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

@* Se renderiza dentro de un Modal (portal): el scope viaja en este div raíz. *@
<div class="abm-page abm-page--socios">
    @if (isLoading)
    {
        <div class="abm-cargando">
            <Spin Size="SpinSize.Large" Tip="Cargando información del socio..." />
        </div>
    }
    else if (socioView != null)
    {
        <div class="abm-detalle-contenido">
            @* Información General *@
            <div class="abm-detalle-titulo">
                <Icon Type="user" /> Información General
            </div>
            <div class="abm-detalle-grid abm-detalle-seccion">
                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">🆔 N° Socio</div>
                    <div class="abm-detalle-valor">@(socioView.NroSocio ?? "No disponible")</div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">🏷️ Tipo</div>
                    <div class="abm-detalle-valor">
                        <span class="abm-badge abm-badge--alerta">
                            @(socioView is SocioPersonaViewModel ? "Persona" : "Empresa")
                        </span>
                    </div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">👤 @(socioView is SocioPersonaViewModel ? "Nombre Completo" : "Razón Social")</div>
                    <div class="abm-detalle-valor">
                        @if (socioView is SocioPersonaViewModel personaView)
                        {
                            @($"{personaView.Nombre} {personaView.Apellido}")
                        }
                        else
                        {
                            @(socioView.Nombre ?? "No disponible")
                        }
                    </div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">@(socioView is SocioPersonaViewModel ? "📇 DNI" : "📇 CUIT")</div>
                    <div class="abm-detalle-valor">
                        @if (socioView is SocioPersonaViewModel persona)
                        {
                            @(persona.Documento ?? "No disponible")
                        }
                        else if (socioView is SocioEmpresaViewModel empresa)
                        {
                            @(empresa.CUIT ?? "No disponible")
                        }
                    </div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">📅 Fecha de Ingreso</div>
                    <div class="abm-detalle-valor">@(socioView.FechaIngreso ?? "No disponible")</div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">📊 Estado</div>
                    <div class="abm-detalle-valor">
                        @{
                            var estadoClass = socioView.Estado == "Activo" ? "abm-badge--aprobado" : "abm-badge--rechazado";
                        }
                        <span class="abm-badge @estadoClass">
                            @(socioView.Estado ?? "No disponible")
                        </span>
                    </div>
                </div>
            </div>

            @* Ubicación *@
            <div class="abm-detalle-titulo">
                <Icon Type="environment" /> Ubicación
            </div>
            <div class="abm-detalle-grid abm-detalle-seccion">
                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">🏠 Dirección</div>
                    <div class="abm-detalle-valor">@(socioView.Direccion ?? "No disponible")</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(socioView.DireccionSecundaria))
                {
                    <div class="abm-detalle-item">
                        <div class="abm-detalle-label">🏠 Dirección Secundaria</div>
                        <div class="abm-detalle-valor">@socioView.DireccionSecundaria</div>
                    </div>
                }

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">🏘️ Zona</div>
                    <div class="abm-detalle-valor">@(socioView.Zona ?? "No disponible")</div>
                </div>

            </div>

            @* Información de Cuota *@
            <div class="abm-detalle-titulo">
                <Icon Type="dollar" /> Información de Cuota
            </div>
            <div class="abm-detalle-grid abm-detalle-seccion">
                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">💰 Monto</div>
                    <div class="abm-detalle-valor">
                        <span class="abm-badge abm-badge--aprobado">
                            $@(socioView.CuotaValor?.ToString("N2") ?? "0.00")
                        </span>
                    </div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">📆 Frecuencia de Pago</div>
                    <div class="abm-detalle-valor">@(socioView.FrecuenciaPago ?? "No disponible")</div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">💳 Forma de Pago</div>
                    <div class="abm-detalle-valor">@(socioView.FormaPago ?? "No disponible")</div>
                </div>
            </div>

            @* Información de Contacto *@
            <div class="abm-detalle-titulo">
                <Icon Type="phone" /> Información de Contacto
            </div>
            <div class="abm-detalle-grid abm-detalle-seccion">
                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">📞 Teléfono</div>
                    <div class="abm-detalle-valor">@(socioView.Telefono ?? "No disponible")</div>
                </div>

                <div class="abm-detalle-item">
                    <div class="abm-detalle-label">📧 Email</div>
                    <div class="abm-detalle-valor">@(socioView.Email ?? "No disponible")</div>
                </div>
            </div>

            @{
                var tieneInfoAdicional = !string.IsNullOrWhiteSpace(socioView.Ocupacion) ||
                !string.IsNullOrWhiteSpace(socioView.NotaAdicional) ||
                (socioView is SocioPersonaViewModel pvm &&
                (!string.IsNullOrWhiteSpace(pvm.FechaNacimiento) || !string.IsNullOrWhiteSpace(pvm.Edad)));
            }
            @if (tieneInfoAdicional)
            {
                <div class="abm-detalle-titulo">
                    <Icon Type="profile" /> Información Adicional
                </div>
                <div class="abm-detalle-grid abm-detalle-seccion">
                    @if (!string.IsNullOrWhiteSpace(socioView.Ocupacion))
                    {
                        <div class="abm-detalle-item">
                            <div class="abm-detalle-label">💼 Ocupación</div>
                            <div class="abm-detalle-valor">@socioView.Ocupacion</div>
                        </div>
                    }
                    @if (socioView is SocioPersonaViewModel personaViewModel)
                    {
                        @if (!string.IsNullOrWhiteSpace(personaViewModel.FechaNacimiento))
                        {
                            <div class="abm-detalle-item">
                                <div class="abm-detalle-label">🎂 Fecha de Nacimiento</div>
                                <div class="abm-detalle-valor">@personaViewModel.FechaNacimiento</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(personaViewModel.Edad))
                        {
                            <div class="abm-detalle-item">
                                <div class="abm-detalle-label">📆 Edad</div>
                                <div class="abm-detalle-valor">@personaViewModel.Edad años</div>
                            </div>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(socioView.NotaAdicional))
                    {
                        <div class="abm-detalle-item abm-detalle-item--full">
                            <div class="abm-detalle-label">📝 Nota Adicional</div>
                            <div class="abm-detalle-valor">@socioView.NotaAdicional</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <Result Status="ResultStatus.Error"
                Title="Error"
                SubTitle="No se pudo cargar la información del socio.">
            <Extra>
                <Button Type="@ButtonType.Primary" OnClick="Cancelar">
                    Volver al listado
                </Button>
            </Extra>
        </Result>
    }
</div>

@code {
    [Parameter] public required int SocioId { get; set; }
    [Parameter] public required EventCallback OnFinishCallback { get; set; }

    private SocioViewModel? socioView;
    private bool isLoading = true;

    public abstract class SocioViewModel
    {
        public string? NroSocio { get; set; }
        public string? Nombre { get; set; }
        public string? Direccion { get; set; }
        public string? DireccionSecundaria { get; set; }
        public string? NotaAdicional { get; set; }
        public string? Zona { get; set; }
        public string? FechaIngreso { get; set; }
        public string? Ocupacion { get; set; }
        public string? Telefono { get; set; }
        public string? Email { get; set; }
        public double? CuotaValor { get; set; }
        public string? FrecuenciaPago { get; set; }
        public string? FormaPago { get; set; }
        public string? Estado { get; set; }
    }

    public class SocioPersonaViewModel : SocioViewModel
    {
        public string? Documento { get; set; }
        public string? Apellido { get; set; }
        public string? FechaNacimiento { get; set; }
        public string? Edad { get; set; }
    }

    public class SocioEmpresaViewModel : SocioViewModel
    {
        public string? CUIT { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            var socio = await SocioService.ObtenerSocioPorIdAsync(SocioId);

            if (socio == null)
            {
                throw new ArgumentNullException("El socio solicitado no existe o ha sido eliminado.");
            }

            MapToViewModel(socio);
        }
        catch (Exception ex)
        {
            await message.ErrorAsync($"Error: {ex.Message}");
            await Cancelar();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Cancelar()
    {
        await OnFinishCallback.InvokeAsync();
    }

    private void MapToViewModel(Socio socio)
    {
        if (socio.Tipo == TipoSocio.Persona)
        {
            string? edad = null;
            if (socio.FechaNacimiento.HasValue)
            {
                var hoy = DateTime.Today;
                var anos = hoy.Year - socio.FechaNacimiento.Value.Year;
                if (socio.FechaNacimiento.Value.Date > hoy.AddYears(-anos))
                    anos--;
                edad = anos.ToString();
            }

            socioView = new SocioPersonaViewModel
            {
                NroSocio = socio.NroSocio.ToString(),
                Nombre = socio.Nombre,
                Apellido = socio.Apellido,
                Documento = socio.DocumentoOCUIT,
                Direccion = socio.Direccion,
                DireccionSecundaria = socio.DireccionSecundaria,
                NotaAdicional = socio.NotaAdicional,
                Zona = socio.Zona.GetDisplayName(),
                FechaIngreso = socio.FechaIngreso?.ToString("dd/MM/yyyy"),
                FechaNacimiento = socio.FechaNacimiento?.ToString("dd/MM/yyyy"),
                Edad = edad,
                Ocupacion = socio.Ocupacion,
                Telefono = socio.Telefono,
                Email = socio.Email,
                CuotaValor = socio.MontoCuota,
                FrecuenciaPago = socio.FrecuenciaDePago.GetDisplayName(),
                FormaPago = socio.FormaPago.GetDisplayName(),
                Estado = socio.EstadoSocio.GetDisplayName()
            };
        }
        else if (socio.Tipo == TipoSocio.Empresa)
        {
            socioView = new SocioEmpresaViewModel
            {
                NroSocio = socio.NroSocio.ToString(),
                Nombre = socio.Nombre,
                CUIT = socio.DocumentoOCUIT,
                Direccion = socio.Direccion,
                DireccionSecundaria = socio.DireccionSecundaria,
                NotaAdicional = socio.NotaAdicional,
                Zona = socio.Zona.GetDisplayName(),
                FechaIngreso = socio.FechaIngreso?.ToString("dd/MM/yyyy"),
                Ocupacion = socio.Ocupacion,
                Telefono = socio.Telefono,
                Email = socio.Email,
                CuotaValor = socio.MontoCuota,
                FrecuenciaPago = socio.FrecuenciaDePago.GetDisplayName(),
                FormaPago = socio.FormaPago.GetDisplayName(),
                Estado = socio.EstadoSocio.GetDisplayName()
            };
        }
    }
}
