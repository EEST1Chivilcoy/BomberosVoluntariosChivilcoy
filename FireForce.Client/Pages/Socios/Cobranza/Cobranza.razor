@page "/fire-force/socios/cobranza"

@using FireForce.Data.Models.Socios
@using FireForce.Data.Models.Socios.Componentes.Pagos
@using FireForce.Shared.Enums.Socios
@using FireForce.Shared.Enums.Discriminadores
@using FireForce.Client.Pages.Socios.Cobranza
@using FireForce.Client.Pages.Socios.Cobranza.Componentes
@using FireForce.Client.Shared
@using Microsoft.EntityFrameworkCore

@*Servicios utilizados*@
@using FireForce.Client.Services
@inject ISocioService SocioService
@inject ISaldoSocioService SaldoSocioService
@inject IPagoService PagoService
@inject IMessageService MessageService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AdminOnly")]

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<div class="abm-page abm-page--cobranza">
    <div class="abm-container" role="main">
    <Card Class="abm-main-card">
        @* ======================================== HEADER SECTION ======================================== *@
        <div class="abm-header-section">
            <div class="lava-bubbles">
                <div class="lava-bubble b1"></div>
                <div class="lava-bubble b2"></div>
                <div class="lava-bubble b3"></div>
                <div class="lava-bubble b4"></div>
                <div class="lava-bubble b5"></div>
            </div>

            <div class="title-container">
                <h1 class="main-title">
                    <Icon Type="dollar" Class="title-icon" />
                    COBRANZA
                </h1>
            </div>

            <div class="filters-section">
                <div class="filter-row">
                    <div class="filter-group" style="flex: 2;">
                        <label class="filter-label">🔍 Buscar</label>
                        <Search Placeholder="Buscar por nombre, N° socio, documento o dirección..."
                                @bind-Value="@TextoBusqueda"
                                Size="InputSize.Large"
                                AllowClear
                                EnterButton="true"
                                OnSearch="@(() => AplicarFiltro())"
                                @oninput="OnBusquedaInput" />
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">📍 Zona</label>
                        <Select TItem="ZonaFiltroItem"
                                TItemValue="Zona ?"
                                DataSource="@ZonasFiltro"
                                @bind-Value="@ZonaSeleccionada"
                                LabelName="@nameof(ZonaFiltroItem.Nombre)"
                                ValueName="@nameof(ZonaFiltroItem.Valor)"
                                Placeholder="Todas las zonas"
                                AllowClear
                                OnSelectedItemChanged="@OnZonaChanged"
                                Size="InputSize.Large" />
                    </div>
                </div>
            </div>
        </div>

        @* ======================================== CONTENIDO PRINCIPAL ======================================== *@
        @if (Cargando)
        {
            <div class="abm-cargando">
                <Spin Size="@SpinSize.Large" Tip="Cargando socios..." />
            </div>
        }
        else if (SociosFiltrados == null || !SociosFiltrados.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid fa-users-slash"></i></div>
                <div class="empty-title">No se encontraron socios</div>
                <div class="empty-description">
                    @if (!string.IsNullOrWhiteSpace(TextoBusqueda) || ZonaSeleccionada != null)
                    {
                        <span>No hay resultados para los filtros aplicados</span>
                    }
                    else
                    {
                        <span>No hay socios con forma de pago en efectivo registrados en el sistema</span>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="cards-container">
                <div class="cards-grid" role="list" aria-label="Lista de socios para cobranza">
                    @foreach (var socio in SociosFiltrados)
                    {
                        var cardClass = socio.Saldo < 0 ? "socio-card-deuda" : (socio.Saldo > 0 ? "socio-card-favor" : "socio-card-neutral");
                        var saldoClass = socio.Saldo < 0 ? "saldo-deuda" : (socio.Saldo > 0 ? "saldo-favor" : "saldo-neutral");
                        var socioId = socio.SocioId;

                        <Card Class="@($"socio-card {cardClass}")" Bordered="false">
                            <div class="card-header">
                                <span class="socio-numero">
                                    <Icon Type="idcard" /> N° @socio.NumeroSocio
                                </span>
                                <span class="@($"saldo-badge {saldoClass}")">
                                    @(socio.Saldo < 0 ? "Debe" : (socio.Saldo > 0 ? "A favor" : "Al día"))
                                    $@Math.Abs(socio.Saldo).ToString("N2")
                                </span>
                            </div>

                            <div class="socio-nombre" title="@socio.NombreApellidoONombreEmpresa">
                                @socio.NombreApellidoONombreEmpresa
                            </div>
                            <div class="socio-documento">
                                <Icon Type="file-text" /> @socio.DocumentoORazonSocial
                            </div>

                            @if (socio.Zona != null && socio.Zona != Zona.Ninguna)
                            {
                                <div class="info-row">
                                    <i class="fa-solid fa-map-marker-alt"></i>
                                    <span class="zona-badge">@socio.Zona.GetDisplayName()</span>
                                </div>
                            }

                            <div class="card-actions">
                                @* Botón normal para desktop *@
                                <div class="desktop-only" style="flex: 1;">
                                    <Button Type="@ButtonType.Primary"
                                            Class="btn-pago"
                                            Style="width: 100%;"
                                            OnClick="@(() => AbrirModalPago(socio))"
                                            AriaLabel="@($"Registrar pago para {socio.NombreApellidoONombreEmpresa}")">
                                        <Icon Type="dollar" /> Registrar Pago
                                    </Button>
                                </div>

                                @* Slide to unlock para móvil *@
                                <div class="mobile-only" style="flex: 1;">
                                    <div class="slide-to-unlock-container"
                                         id="slide-container-@socioId"
                                         @ontouchstart="@(e => OnSlideStart(e, socio))"
                                         @ontouchmove="@(e => OnSlideMove(e, socio))"
                                         @ontouchend="@(e => OnSlideEnd(e, socio))"
                                         @onmousedown="@(e => OnMouseSlideStart(e, socio))"
                                         @onmousemove="@(e => OnMouseSlideMove(e, socio))"
                                         @onmouseup="@(e => OnMouseSlideEnd(e, socio))"
                                         @onmouseleave="@(e => OnMouseSlideEnd(e, socio))">
                                        <div class="slide-success-bg" style="width: @(GetSlideProgress(socioId))%;"></div>
                                        <div class="slide-track">
                                            <span class="slide-text" style="opacity: @(1 - GetSlideProgress(socioId) / 100);">
                                                <Icon Type="arrow-right" /> Deslizar para pagar
                                            </span>
                                        </div>
                                        <div class="slide-thumb @(IsSlideUnlocked(socioId) ? "unlocked" : "")"
                                             style="left: @(4 + GetSlideProgress(socioId) * 2.5)px;">
                                            <Icon Type="dollar" />
                                        </div>
                                    </div>
                                </div>

                                <Button Type="@ButtonType.Primary"
                                        Class="btn-ubicacion"
                                        OnClick="@(() => AbrirGoogleMaps(socio))"
                                        AriaLabel="@($"Ver ubicación de {socio.NombreApellidoONombreEmpresa} en Google Maps")">
                                    <Icon Type="environment" /> Ver Mapa
                                </Button>
                            </div>
                        </Card>
                    }
                </div>
            </div>
        }
    </Card>
    </div>

    @* ======================================== MODAL DE PAGO ======================================== *@
    <Modal @bind-Visible="@ModalPagoVisible"
           Title="@($"💵 Registrar Pago - N° {SocioSeleccionado?.NumeroSocio}")"
           Width="500"
           Footer="null"
           WrapClassName="modal-pago"
           DestroyOnClose
           Centered>
        <RegistrarPago Socio="@SocioSeleccionado"
                       OnCancel="@CerrarModalPago"
                       OnPagoConfirmado="@OnPagoConfirmado" />
    </Modal>

    @* ======================================== MODAL DE SELECCIÓN DE DIRECCIÓN ======================================== *@
    <Modal @bind-Visible="@ModalDireccionVisible"
           Title="@($"📍 Seleccionar Ubicación - {SocioParaMapa?.NombreApellidoONombreEmpresa}")"
           Width="450"
           Footer="null"
           WrapClassName="modal-direccion"
           DestroyOnClose
           Centered>
        <div class="seleccionar-direccion-content">
            @{
                var tieneDireccionPrincipal = TieneDireccionPrincipalDisponible();
                var tieneDireccionSecundaria = TieneDireccionSecundariaDisponible();
                var tieneNotaAdicional = TieneNotaAdicionalDisponible();
            }

            @* Dirección Principal *@
            <div class="direccion-option @(tieneDireccionPrincipal ? "" : "disabled")" 
                 @onclick="@(() => { if (tieneDireccionPrincipal) SeleccionarDireccion(DireccionTipo.Principal); })">
                <div class="direccion-option-header">
                    <i class="fa-solid fa-house direccion-option-icon"></i>
                    <span class="direccion-option-label">Dirección Principal</span>
                </div>
                <div class="direccion-option-text">
                    @if (tieneDireccionPrincipal)
                    {
                        @SocioParaMapa?.Domicilio
                    }
                    else
                    {
                        <span class="direccion-no-disponible">Sin coordenadas disponibles</span>
                    }
                </div>
            </div>

            @* Dirección Secundaria *@
            <div class="direccion-option @(tieneDireccionSecundaria ? "" : "disabled")" 
                 @onclick="@(() => { if (tieneDireccionSecundaria) SeleccionarDireccion(DireccionTipo.Secundaria); })">
                <div class="direccion-option-header">
                    <i class="fa-solid fa-building direccion-option-icon"></i>
                    <span class="direccion-option-label">Dirección Secundaria</span>
                </div>
                <div class="direccion-option-text">
                    @if (tieneDireccionSecundaria)
                    {
                        @SocioParaMapa?.DomicilioSecundario
                    }
                    else
                    {
                        <span class="direccion-no-disponible">Sin coordenadas disponibles</span>
                    }
                </div>
            </div>

            @* Nota Adicional *@
            <div class="direccion-option @(tieneNotaAdicional ? "" : "disabled")" 
                 @onclick="@(() => { if (tieneNotaAdicional) MostrarNotaAdicional(); })">
                <div class="direccion-option-header">
                    <i class="fa-solid fa-sticky-note direccion-option-icon"></i>
                    <span class="direccion-option-label">Nota Extra</span>
                </div>
                <div class="direccion-option-text">
                    @if (tieneNotaAdicional)
                    {
                        @SocioParaMapa?.NotaAdicional
                    }
                    else
                    {
                        <span class="direccion-no-disponible">Sin nota adicional</span>
                    }
                </div>
            </div>

            <div class="direccion-footer">
                <Button OnClick="@CerrarModalDireccion">
                    Cancelar
                </Button>
            </div>
        </div>
    </Modal>

    @* ======================================== MODAL POST-IT (NOTA ADICIONAL) ======================================== *@
    <Modal @bind-Visible="@ModalNotaVisible"
           Title=""
           Width="400"
           Footer="null"
           WrapClassName="modal-postit"
           DestroyOnClose
           Centered>
        <div class="postit-container">
            <div class="postit-note">
                <div class="postit-header">
                    <i class="fa-solid fa-thumbtack postit-icon"></i>
                    <h3 class="postit-title">📝 Nota</h3>
                </div>
                <div class="postit-content">
                    @SocioParaMapa?.NotaAdicional
                </div>
                <div class="postit-footer">
                    <Button Class="postit-btn-cerrar" OnClick="@CerrarModalNota">
                        <Icon Type="check" /> Entendido
                    </Button>
                </div>
            </div>
            <div class="postit-shadow"></div>
        </div>
    </Modal>
</div>

@code {
    // ======================================== PROPIEDADES ========================================

    private List<Socio>? Socios { get; set; } = new();
    private List<CobranzaViewModel> CobranzaViewModels { get; set; } = new();
    private List<CobranzaViewModel> SociosFiltrados { get; set; } = new();

    private string TextoBusqueda { get; set; } = string.Empty;
    private bool Cargando { get; set; } = true;
    private bool ModalPagoVisible { get; set; } = false;
    private bool ModalDireccionVisible { get; set; } = false;
    private bool ModalNotaVisible { get; set; } = false;

    private CobranzaViewModel? SocioSeleccionado { get; set; }
    private CobranzaViewModel? SocioParaMapa { get; set; }

    // Filtro de zona
    private Zona? ZonaSeleccionada { get; set; } = null;
    private List<ZonaFiltroItem> ZonasFiltro { get; set; } = new();

    // Slide to unlock state
    private Dictionary<int, double> SlideProgress { get; set; } = new();
    private Dictionary<int, bool> SlideActive { get; set; } = new();
    private Dictionary<int, double> SlideStartX { get; set; } = new();

    // ======================================== CLASES AUXILIARES ========================================

    public class ZonaFiltroItem
    {
        public string Nombre { get; set; } = string.Empty;
        public Zona? Valor { get; set; }
    }

    // ======================================== LIFECYCLE ========================================

    protected override async Task OnInitializedAsync()
    {
        InicializarFiltroZonas();
        await CargarSocios();
    }

    // ======================================== MÉTODOS DE CARGA ========================================

    private void InicializarFiltroZonas()
    {
        ZonasFiltro = new List<ZonaFiltroItem>
        {
            new ZonaFiltroItem { Nombre = "Todas las zonas", Valor = null }
        };

        foreach (Zona zona in Enum.GetValues(typeof(Zona)))
        {
            if (zona != Zona.Ninguna)
            {
                ZonasFiltro.Add(new ZonaFiltroItem
                {
                    Nombre = zona.GetDisplayName(),
                    Valor = zona
                });
            }
        }
    }

    private async Task CargarSocios()
    {
        Cargando = true;
        StateHasChanged();

        // Ceder el control al hilo de la UI para asegurar que el spinner se renderice
        await Task.Delay(10); 

        try
        {
            Socios = await SocioService.ObtenerSociosAsync();

            if (Socios != null)
            {
                var sociosFiltradosBase = Socios
                    .Where(s => s.FormaPago == FormaDePago.Efectivo)
                    .ToList();

                // Extraemos los IDs para consultar todo de manera masiva (y evitar el problema de N+1)
                var socioIds = sociosFiltradosBase.Select(s => s.Id).ToList();
                var saldos = await SaldoSocioService.CalcularSaldosMasivoAsync(socioIds);

                var cobranzaViewModels = new List<CobranzaViewModel>();

                foreach (var s in sociosFiltradosBase)
                {
                    var saldo = saldos.GetValueOrDefault(s.Id, 0m);

                    cobranzaViewModels.Add(new CobranzaViewModel
                    {
                        SocioId = s.Id,
                        NumeroSocio = s.NroSocio,
                        NombreApellidoONombreEmpresa = s.Tipo == TipoSocio.Persona
                            ? $"{s.Apellido}, {s.Nombre}"
                            : s.Nombre ?? "Sin nombre",
                        DocumentoORazonSocial = s.DocumentoOCUIT ?? "Sin documento",
                        Domicilio = s.Direccion ?? "Sin dirección",
                        DomicilioSecundario = s.DireccionSecundaria,
                        Saldo = saldo,
                        Latitud = s.Latitud.HasValue ? (decimal?)s.Latitud.Value : null,
                        Longitud = s.Longitud.HasValue ? (decimal?)s.Longitud.Value : null,
                        LatitudSecundaria = s.LatitudSecundaria.HasValue ? (decimal?)s.LatitudSecundaria.Value : null,
                        LongitudSecundaria = s.LongitudSecundaria.HasValue ? (decimal?)s.LongitudSecundaria.Value : null,
                        NotaAdicional = s.NotaAdicional,
                        Telefono = s.Telefono,
                        MontoCuota = (decimal)s.MontoCuota,
                        Zona = s.Zona
                    });
                }

                CobranzaViewModels = cobranzaViewModels
                    .OrderBy(s => s.Saldo)
                    .ThenBy(s => s.NombreApellidoONombreEmpresa)
                    .ToList();

                // Inicializar estado del slide para cada socio
                foreach (var socio in CobranzaViewModels)
                {
                    SlideProgress[socio.SocioId] = 0;
                    SlideActive[socio.SocioId] = false;
                    SlideStartX[socio.SocioId] = 0;
                }

                AplicarFiltro();
            }
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"Error al cargar los socios: {ex.Message}");
            Console.WriteLine($"Error al cargar los socios: {ex.Message}");
        }
        finally
        {
            Cargando = false;
            StateHasChanged();
        }
    }

    // ======================================== BÚSQUEDA Y FILTRADO ========================================

    private void OnBusquedaInput(ChangeEventArgs e)
    {
        TextoBusqueda = e.Value?.ToString() ?? string.Empty;
        AplicarFiltro();
    }

    private void OnZonaChanged(ZonaFiltroItem? item)
    {
        ZonaSeleccionada = item?.Valor;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        var query = CobranzaViewModels.AsEnumerable();

        // Filtro por texto
        if (!string.IsNullOrWhiteSpace(TextoBusqueda))
        {
            var busqueda = TextoBusqueda.ToLower().Trim();
            query = query.Where(s =>
                (s.NombreApellidoONombreEmpresa?.ToLower().Contains(busqueda) ?? false) ||
                s.NumeroSocio.ToString().Contains(busqueda) ||
                (s.DocumentoORazonSocial?.ToLower().Contains(busqueda) ?? false) ||
                (s.Domicilio?.ToLower().Contains(busqueda) ?? false));
        }

        // Filtro por zona
        if (ZonaSeleccionada != null)
        {
            query = query.Where(s => s.Zona == ZonaSeleccionada);
        }

        SociosFiltrados = query
            .OrderBy(s => s.Saldo)
            .ThenBy(s => s.NombreApellidoONombreEmpresa)
            .ToList();

        StateHasChanged();
    }

    // ======================================== SLIDE TO UNLOCK ========================================

    private double GetSlideProgress(int socioId)
    {
        return SlideProgress.TryGetValue(socioId, out var progress) ? progress : 0;
    }

    private bool IsSlideUnlocked(int socioId)
    {
        return GetSlideProgress(socioId) >= 95;
    }

    private void OnSlideStart(TouchEventArgs e, CobranzaViewModel socio)
    {
        if (e.Touches.Length > 0)
        {
            SlideActive[socio.SocioId] = true;
            SlideStartX[socio.SocioId] = e.Touches[0].ClientX;
        }
    }

    private void OnSlideMove(TouchEventArgs e, CobranzaViewModel socio)
    {
        if (!SlideActive.TryGetValue(socio.SocioId, out var active) || !active) return;
        if (e.Touches.Length == 0) return;

        var currentX = e.Touches[0].ClientX;
        var startX = SlideStartX.TryGetValue(socio.SocioId, out var sx) ? sx : 0;
        var deltaX = currentX - startX;

        var maxSlide = 200;
        var progress = Math.Max(0, Math.Min(100, (deltaX / maxSlide) * 100));

        SlideProgress[socio.SocioId] = progress;
        StateHasChanged();
    }

    private async Task OnSlideEnd(TouchEventArgs e, CobranzaViewModel socio)
    {
        if (!SlideActive.TryGetValue(socio.SocioId, out var active) || !active) return;

        SlideActive[socio.SocioId] = false;

        if (GetSlideProgress(socio.SocioId) >= 95)
        {
            // Desbloqueado - abrir modal
            SlideProgress[socio.SocioId] = 100;
            StateHasChanged();

            await Task.Delay(200); // Pequeña animación
            AbrirModalPago(socio);

            // Reset
            SlideProgress[socio.SocioId] = 0;
        }
        else
        {
            // No llegó al final - resetear
            SlideProgress[socio.SocioId] = 0;
        }

        StateHasChanged();
    }

    // Mouse events para testing en desktop
    private void OnMouseSlideStart(MouseEventArgs e, CobranzaViewModel socio)
    {
        SlideActive[socio.SocioId] = true;
        SlideStartX[socio.SocioId] = e.ClientX;
    }

    private void OnMouseSlideMove(MouseEventArgs e, CobranzaViewModel socio)
    {
        if (!SlideActive.TryGetValue(socio.SocioId, out var active) || !active) return;

        var startX = SlideStartX.TryGetValue(socio.SocioId, out var sx) ? sx : 0;
        var deltaX = e.ClientX - startX;

        var maxSlide = 200;
        var progress = Math.Max(0, Math.Min(100, (deltaX / maxSlide) * 100));

        SlideProgress[socio.SocioId] = progress;
        StateHasChanged();
    }

    private async Task OnMouseSlideEnd(MouseEventArgs e, CobranzaViewModel socio)
    {
        if (!SlideActive.TryGetValue(socio.SocioId, out var active) || !active) return;

        SlideActive[socio.SocioId] = false;

        if (GetSlideProgress(socio.SocioId) >= 95)
        {
            // Desbloqueado - abrir modal
            SlideProgress[socio.SocioId] = 100;
            StateHasChanged();

            await Task.Delay(200); // Pequeña animación
            AbrirModalPago(socio);

            // Reset
            SlideProgress[socio.SocioId] = 0;
        }
        else
        {
            // No llegó al final - resetear
            SlideProgress[socio.SocioId] = 0;
        }

        StateHasChanged();
    }

    // ======================================== MODAL DE PAGO ========================================

    private void AbrirModalPago(CobranzaViewModel socio)
    {
        SocioSeleccionado = socio;
        ModalPagoVisible = true;
    }

    private void CerrarModalPago()
    {
        ModalPagoVisible = false;
        SocioSeleccionado = null;
    }

    private async Task OnPagoConfirmado(PagoEfectivo pago)
    {
        try
        {
            await PagoService.AgregarPagoAsync(pago.SocioId, pago);

            await MessageService.SuccessAsync($"Pago de ${pago.Monto:N2} registrado correctamente para {SocioSeleccionado?.NombreApellidoONombreEmpresa}");

            CerrarModalPago();
            await CargarSocios();
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"Error al registrar el pago: {ex.Message}");
        }
    }

    // ======================================== GOOGLE MAPS ========================================

    private enum DireccionTipo
    {
        Principal,
        Secundaria
    }

    private void AbrirGoogleMaps(CobranzaViewModel socio)
    {
        SocioParaMapa = socio;
        ModalDireccionVisible = true;
    }

    private bool TieneDireccionPrincipalDisponible()
    {
        return SocioParaMapa != null &&
               SocioParaMapa.Latitud.HasValue && SocioParaMapa.Longitud.HasValue &&
               SocioParaMapa.Latitud != 0 && SocioParaMapa.Longitud != 0;
    }

    private bool TieneDireccionSecundariaDisponible()
    {
        return SocioParaMapa != null &&
               !string.IsNullOrWhiteSpace(SocioParaMapa.DomicilioSecundario) &&
               SocioParaMapa.LatitudSecundaria.HasValue && SocioParaMapa.LongitudSecundaria.HasValue &&
               SocioParaMapa.LatitudSecundaria != 0 && SocioParaMapa.LongitudSecundaria != 0;
    }

    private bool TieneNotaAdicionalDisponible()
    {
        return SocioParaMapa != null && !string.IsNullOrWhiteSpace(SocioParaMapa.NotaAdicional);
    }

    private void CerrarModalDireccion()
    {
        ModalDireccionVisible = false;
        // Solo limpiar SocioParaMapa si no se va a mostrar el modal de nota
        if (!ModalNotaVisible)
        {
            SocioParaMapa = null;
        }
    }

    private async Task SeleccionarDireccion(DireccionTipo tipo)
    {
        if (SocioParaMapa == null) return;

        decimal latitud, longitud;

        if (tipo == DireccionTipo.Principal)
        {
            latitud = SocioParaMapa.Latitud ?? 0;
            longitud = SocioParaMapa.Longitud ?? 0;
        }
        else
        {
            latitud = SocioParaMapa.LatitudSecundaria ?? 0;
            longitud = SocioParaMapa.LongitudSecundaria ?? 0;
        }

        CerrarModalDireccion();
        await AbrirMapaConCoordenadas(latitud, longitud);
    }

    private void MostrarNotaAdicional()
    {
        if (SocioParaMapa == null || string.IsNullOrWhiteSpace(SocioParaMapa.NotaAdicional)) return;

        ModalNotaVisible = true;
    }

    private void CerrarModalNota()
    {
        ModalNotaVisible = false;
    }

    private async Task AbrirMapaConCoordenadas(decimal latitud, decimal longitud)
    {
        var url = $"https://www.google.com/maps/search/?api=1&query={latitud.ToString(System.Globalization.CultureInfo.InvariantCulture)},{longitud.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
    }
}