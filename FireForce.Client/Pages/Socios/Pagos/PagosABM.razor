@using AntDesign.TableModels
@using FireForce.Client.Pages.Socios.Pagos.Componentes
@using FireForce.Data.Models.Socios.Componentes.Pagos
@using FireForce.Data.Models.Socios
@using FireForce.Data.Models.Personas.Personal
@using FireForce.Shared.Enums.Socios
@using FireForce.Shared.Enums.Discriminadores
@using FireForce.Client.Data.Mappers
@using FireForce.Client.Data.ViewModels.Socios

@*Servicios utilizados*@
@using FireForce.Client.Services;
@inject IPagoService PagoService
@inject ISocioService SocioService
@inject ICobradorService CobradorService
@inject IMessageService MessageService
@inject NavigationManager navigationManager

@page "/fire-force/socios/pagos"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "SecretariaOrAdmin")]

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<div class="abm-page abm-page--pagos">
    <div class="abm-container">
        <Card Class="abm-main-card">
            <div class="abm-header-section">
                <div class="lava-bubbles">
                    <div class="lava-bubble b1"></div>
                    <div class="lava-bubble b2"></div>
                    <div class="lava-bubble b3"></div>
                    <div class="lava-bubble b4"></div>
                    <div class="lava-bubble b5"></div>
                </div>
                <div class="title-container">
                    <h1 class="main-title">
                        <Icon Type="dollar" Class="title-icon" />
                        PAGOS
                    </h1>
                </div>
                <div class="filters-section">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label class="filter-label">📅 Fecha Desde</label>
                            <DatePicker Mask="dd/MM/yyyy" TValue="DateTime"
                                        DefaultValue="@DateTime.Now.AddDays(-30)"
                                        @bind-Value="@FechaBuscarI"
                                        Size="InputSize.Large"
                                        Placeholder="@("Seleccionar fecha")" />
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">📅 Fecha Hasta</label>
                            <DatePicker Mask="dd/MM/yyyy" TValue="DateTime"
                                        DefaultValue="@DateTime.Now.AddDays(30)"
                                        @bind-Value="@FechaBuscarF"
                                        Size="InputSize.Large"
                                        Placeholder="@("Seleccionar fecha")" />
                        </div>
                    </div>

                    <div class="actions-row">
                        <div class="search-container">
                            <Search Placeholder="🔍 Buscar por nombre de socio o nro..."
                                    AllowClear
                                    EnterButton="true"
                                    Size="InputSize.Large"
                                    OnSearch="@(() => PagosFiltrados = FiltrarPagos())"
                                    @bind-Value="Busqueda" />
                        </div>

                        <Button Class="modern-button add-button"
                                OnClick="@(() => _modalAñadirVisible = true)"
                                Icon="plus"
                                Size="ButtonSize.Large">
                            Nuevo Pago
                        </Button>

                        <Button Class="modern-button print-button"
                                OnClick="@(() => _modalImprimirVisible = true)"
                                Icon="printer"
                                Size="ButtonSize.Large">
                            Imprimir
                        </Button>

                        <Dropdown Trigger="@(new Trigger[] { Trigger.Click })"
                                  Placement="Placement.BottomRight"
                                  Arrow>
                            <Overlay>
                                <div style="min-width: 520px; max-width: 90vw;">
                                    <PagosAprobar OnCompleted="@Init" />
                                </div>
                            </Overlay>
                            <ChildContent>
                                <Badge Count="@PagosPendientesAprobacion" ShowZero="false">
                                    <Button Class="notification-button" Shape="ButtonShape.Circle" Size="ButtonSize.Large">
                                        <Icon Type="bell" />
                                    </Button>
                                </Badge>
                            </ChildContent>
                        </Dropdown>
                    </div>
                </div>
            </div>

            <div class="abm-table-container">
                <Table DataSource="PagosFiltrados"
                       HidePagination="false"
                       Responsive
                       TItem="PagoViewModel"
                       RowClassName="@(c => c.Data.Estado.ToString())"
                       OnRow="@OnRowClick"
                       Loading="@_loading"
                       ScrollX="800px">

                    <ColumnDefinitions Context="pago">
                        <PropertyColumn Title="👤 Socio"
                                        Property="c => c.NombreSocio"
                                        Sortable
                                        Width="250px"
                                        Fixed="ColumnFixPlacement.Left">
                            <Template>
                                <div style="font-weight: 600; color: #333;">
                                    @pago.NombreSocio
                                </div>
                                <div style="font-size: 0.8rem; color: #666;">
                                    Nro Socio: @pago.NumeroSocio
                                </div>
                            </Template>
                        </PropertyColumn>

                        <PropertyColumn Title="📅 Fecha"
                                        Property="c => c.Fecha"
                                        Format="dd/MM/yyyy"
                                        Sortable
                                        DefaultSortOrder="SortDirection.Descending"
                                        Width="120px" />

                        <PropertyColumn Title="💵 Monto"
                                        Property="c => c.Monto"
                                        Sortable
                                        Width="120px">
                            <Template>
                                <Tag Color="TagColor.Processing" Style="font-size: 0.95rem; font-weight: 600;">
                                    @pago.Monto.ToString("C2")
                                </Tag>
                            </Template>
                        </PropertyColumn>

                        <PropertyColumn Title="🏷️ Tipo"
                                        Property="c => c.Tipo.ToString()"
                                        Sortable
                                        Width="150px" />

                        <PropertyColumn Title="📊 Estado"
                                        Property="c => c.Estado"
                                        Sortable
                                        Width="150px"
                                        Fixed="ColumnFixPlacement.Right">
                            <Template>
                                @{
                                    string statusClass = pago.Estado switch
                                    {
                                        EstadoPago.Rechazado => "abm-badge--rechazado",
                                        EstadoPago.Confirmado => "abm-badge--aprobado",
                                        _ => "abm-badge--alerta"
                                    };
                                    string icon = pago.Estado switch
                                    {
                                        EstadoPago.Rechazado => "close-circle",
                                        EstadoPago.Confirmado => "check-circle",
                                        _ => "clock-circle"
                                    };
                                }
                                <Space>
                                    <Icon Type="@icon" />
                                    <span class="abm-badge @statusClass">
                                        @pago.Estado.ToString()
                                    </span>
                                </Space>
                            </Template>
                        </PropertyColumn>
                    </ColumnDefinitions>
                </Table>
            </div>
        </Card>
    </div>
</div>

@* Modal para añadir pago *@
<Modal @bind-Visible="_modalAñadirVisible"
       Title="Nuevo Pago en Efectivo"
       Width="@("100%")"
       Style="max-width: 700px;"
       Footer="null"
       DestroyOnClose
       WrapClassName="modal-crear-pago">
    <div class="modal-crear-pago-content">
        <Form Model="nuevoPago" Layout="FormLayout.Vertical" OnFinish="AddPago" Loading="isLoadingComponent">

            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <FormItem Label="👤 Socio" Required>
                        <Select TItem="Socio"
                                TItemValue="int"
                                DataSource="@SociosList"
                                @bind-Value="@nuevoPago.SocioId"
                                LabelName="@nameof(Socio.Nombre)"
                                ValueName="@nameof(Socio.Id)"
                                Placeholder="Seleccione el socio"
                                AllowClear
                                EnableSearch
                                Size="InputSize.Large">
                            <ItemTemplate Context="socioCtx">
                                <span>@socioCtx.Nombre @socioCtx.Apellido - (Nº @socioCtx.NroSocio)</span>
                            </ItemTemplate>
                        </Select>
                    </FormItem>
                </AntDesign.Col>

                <AntDesign.Col Span="12">
                    <FormItem Label="👤 Cobrador" Required>
                        <Select TItem="Cobrador"
                                TItemValue="int"
                                DataSource="@CobradoresList"
                                @bind-Value="@nuevoPago.CobradorId"
                                LabelName="@nameof(Cobrador.Nombre)"
                                ValueName="@nameof(Cobrador.PersonaId)"
                                Placeholder="Seleccione el cobrador"
                                AllowClear
                                EnableSearch
                                Size="InputSize.Large">
                            <ItemTemplate Context="cobCtx">
                                <span>@cobCtx.Nombre @cobCtx.Apellido</span>
                            </ItemTemplate>
                        </Select>
                    </FormItem>
                </AntDesign.Col>
            </Row>

            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <FormItem Label="💵 Monto" Required>
                        <AntDesign.InputNumber @bind-Value="@nuevoPago.Monto"
                                               Min="1"
                                               Size="InputSize.Large"
                                               Style="width: 100%;" />
                    </FormItem>
                </AntDesign.Col>

                <AntDesign.Col Span="12">
                    <FormItem Label="📅 Fecha del Pago" Required>
                        <DatePicker Mask="dd/MM/yyyy" TValue="DateTime"
                                    @bind-Value="@nuevoPago.Fecha"
                                    Placeholder="@("Seleccione fecha")"
                                    Size="InputSize.Large"
                                    Style="width: 100%;" />
                    </FormItem>
                </AntDesign.Col>
            </Row>

            <FormItem Label="📝 Observaciones (Opcional)">
                <TextArea @bind-Value="@nuevoPago.Observaciones"
                          Placeholder="Notas sobre el pago..."
                          Rows="3" />
            </FormItem>

            <div class="modal-footer-abm">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Size="ButtonSize.Large">
                    Registrar Pago
                </Button>
            </div>
        </Form>
    </div>
</Modal>

<Modal Title="Imprimir Bonos de Socios"
       Footer="null"
       Centered="@true"
       OnCancel="@(() => _modalParametrosBonosVisible = false)"
       Visible="@_modalParametrosBonosVisible"
       Width="500">
    @* El Modal se monta en un portal fuera de .abm-page: el scope viaja en este div raíz. *@
    <div class="modal-imprimir-zonas">
        <h4 class="modal-imprimir-zonas-titulo">
            <Icon Type="file-text" />
            Seleccione Zona, Mes y Año
        </h4>

        <div class="modal-imprimir-zonas-campos">
            <div class="modal-imprimir-zonas-campo">
                <label>Mes</label>
                <AntDesign.InputNumber @bind-Value="selectedBonosMes" Min="1" Max="12" />
            </div>

            <div class="modal-imprimir-zonas-campo">
                <label>Año</label>
                <AntDesign.InputNumber @bind-Value="selectedBonosAnio" Min="2000" Max="2100" />
            </div>
        </div>

        @foreach (var zona in GetZonasDisponibles())
        {
            <div class="print-modal-option @(selectedBonosZona == zona ? "selected" : "")"
                 @onclick="() => SelectBonosZona(zona)">
                <Icon Type="environment" Class="option-icon" />
                <div class="option-text">
                    <h4>@zona.GetDisplayName()</h4>
                    <p>Imprimir bonos solo de esta zona</p>
                </div>
            </div>
        }

        <div class="print-modal-actions">
            <Button OnClick="@(() => _modalParametrosBonosVisible = false)">
                Cancelar
            </Button>
            <Button Type="ButtonType.Primary" Class="print-confirm-button" OnClick="ConfirmPrintBonos">
                <Icon Type="printer" /> Imprimir
            </Button>
        </div>
    </div>
</Modal>

<Modal @bind-Visible="_modalImprimirVisible"
       Title="Imprimir"
       Width="@("100%")"
       Style="max-width: 680px;"
       Footer="null"
       DestroyOnClose
       WrapClassName="modal-imprimir-pago">
    <div class="modal-imprimir-content">
        <p class="modal-imprimir-subtitle">Seleccione qué desea imprimir</p>

        <div class="modal-imprimir-options">
            <Button Class="modal-imprimir-option"
                    OnClick="ImprimirBonos">
                <Icon Type="file-text" Class="modal-imprimir-option-icon" />
                <p class="modal-imprimir-option-title">Imprimir Bonos</p>
                <p class="modal-imprimir-option-description">Genera la impresión de bonos para su control y distribución.</p>
            </Button>

            <Button Class="modal-imprimir-option"
                    OnClick="ImprimirListaCobranza">
                <Icon Type="unordered-list" Class="modal-imprimir-option-icon" />
                <p class="modal-imprimir-option-title">Imprimir Lista Cobranza</p>
                <p class="modal-imprimir-option-description">Imprime el listado de cobranza para trabajo en campo.</p>
            </Button>
        </div>
    </div>
</Modal>

<Modal Title="Imprimir Lista de Cobranza"
       Footer="null"
       Centered="@true"
       OnCancel="@(() => _modalParametrosCobranzaVisible = false)"
       Visible="@_modalParametrosCobranzaVisible"
       Width="500">
    @* El Modal se monta en un portal fuera de .abm-page: el scope viaja en este div raíz. *@
    <div class="modal-imprimir-zonas">
        <h4 class="modal-imprimir-zonas-titulo">
            <Icon Type="printer" />
            Seleccione Zona y Año
        </h4>

        <div class="modal-imprimir-zonas-campos">
            <div class="modal-imprimir-zonas-campo">
                <label>Año de Cobranza</label>
                <AntDesign.InputNumber @bind-Value="selectedAnio" Min="2000" Max="2100" />
            </div>
        </div>

        @foreach (var zona in GetZonasDisponibles())
        {
            <div class="print-modal-option @(selectedPrintZona == zona ? "selected" : "")"
                 @onclick="() => SelectPrintZona(zona)">
                <Icon Type="environment" Class="option-icon" />
                <div class="option-text">
                    <h4>@zona.GetDisplayName()</h4>
                    <p>Imprimir solo pagos de esta zona</p>
                </div>
            </div>
        }

        <div class="print-modal-actions">
            <Button OnClick="@(() => _modalParametrosCobranzaVisible = false)">
                Cancelar
            </Button>
            <Button Type="ButtonType.Primary" Class="print-confirm-button" OnClick="ConfirmPrintCobranza">
                <Icon Type="printer" /> Imprimir
            </Button>
        </div>
    </div>
</Modal>

@* Modal de detalle *@
<Modal @bind-Visible="_modalDetalleVisible"
       Title="@($"📋 Detalle de Pago - {pagoSeleccionado?.NombreSocio}")"
       Footer="null"
       Width="@("90%")"
       Style="max-width: 800px;">
    @if (pagoSeleccionado != null)
    {
        @* El Modal se monta en un portal fuera de .abm-page: el scope viaja en este div raíz. *@
        <div class="abm-page abm-page--pagos">
            <div class="modal-content">
                <div class="abm-detalle-grid">
                    <div class="abm-detalle-item">
                        <div class="abm-detalle-label">👤 Socio</div>
                        <div class="abm-detalle-valor">@pagoSeleccionado.NombreSocio</div>
                    </div>

                    <div class="abm-detalle-item">
                        <div class="abm-detalle-label">📋 Nro Socio</div>
                        <div class="abm-detalle-valor">@pagoSeleccionado.NumeroSocio</div>
                    </div>

                    <div class="abm-detalle-item">
                        <div class="abm-detalle-label">💵 Monto</div>
                        <div class="abm-detalle-valor">
                            <Tag Color="TagColor.Processing" Style="font-size: 1rem; padding: 4px 12px;">
                                @pagoSeleccionado.Monto.ToString("C2")
                            </Tag>
                        </div>
                    </div>

                    <div class="abm-detalle-item">
                        <div class="abm-detalle-label">📅 Fecha de Pago</div>
                        <div class="abm-detalle-valor">@pagoSeleccionado.Fecha.ToString("dd MMMM yyyy")</div>
                    </div>

                    <div class="abm-detalle-item">
                        <div class="abm-detalle-label">🏷️ Tipo</div>
                        <div class="abm-detalle-valor">@pagoSeleccionado.Tipo.ToString()</div>
                    </div>

                    <div class="abm-detalle-item">
                        <div class="abm-detalle-label">📊 Estado</div>
                        <div class="abm-detalle-valor">
                            @{
                                string statusClass = pagoSeleccionado.Estado switch
                                {
                                    EstadoPago.Rechazado => "abm-badge--rechazado",
                                    EstadoPago.Confirmado => "abm-badge--aprobado",
                                    _ => "abm-badge--alerta"
                                };
                            }
                            <span class="abm-badge @statusClass">
                                @pagoSeleccionado.Estado.ToString()
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(pagoSeleccionado.NombreCobrador))
                    {
                        <div class="abm-detalle-item">
                            <div class="abm-detalle-label">👤 Cobrador</div>
                            <div class="abm-detalle-valor">@pagoSeleccionado.NombreCobrador</div>
                        </div>
                    }
                    
                    @if (!string.IsNullOrWhiteSpace(pagoSeleccionado.Observaciones))
                    {
                        <div class="abm-detalle-item abm-detalle-item--full">
                            <div class="abm-detalle-label">📝 Observaciones</div>
                            <div class="abm-detalle-valor">@pagoSeleccionado.Observaciones</div>
                        </div>
                    }

                    @if (pagoSeleccionado.Estado == EstadoPago.Rechazado)
                    {
                        <div class="abm-detalle-item abm-detalle-item--full" style="border-color: var(--abm-error-color);">
                            <div class="abm-detalle-label" style="color: var(--abm-error-color);">❌ Razón de Rechazo</div>
                            <div class="abm-detalle-valor">@(string.IsNullOrEmpty(pagoSeleccionado.RazonRechazo) ? "No especificada" : pagoSeleccionado.RazonRechazo)</div>
                        </div>
                    }
                </div>

                <div style="display: flex; justify-content: center; margin-top: 24px;">
                    <Button Type="ButtonType.Primary"
                            Size="ButtonSize.Large"
                            OnClick="@(() => _modalDetalleVisible = false)">
                        Cerrar
                    </Button>
                </div>
            </div>
        </div>
    }
</Modal>

@code {
    // Variables de búsqueda
    DateTime FechaBuscarI = DateTime.Now.AddDays(-30);
    DateTime FechaBuscarF = DateTime.Now.AddDays(30);
    string? Busqueda;
    bool _loading = false;
    private bool isLoadingComponent = false;

    // Listas
    List<PagoViewModel> PagosOriginales = new();
    List<PagoViewModel> PagosFiltrados = new();
    List<Socio> SociosList = new();
    List<Cobrador> CobradoresList = new();

    int PagosPendientesAprobacion => PagosOriginales.Count(p => p.Estado == EstadoPago.PendienteAConfirmar);

    // Modal forms
    private bool _modalAñadirVisible = false;
    private bool _modalImprimirVisible = false;
    private bool _modalParametrosCobranzaVisible = false;
    private bool _modalParametrosBonosVisible = false;
    private Zona? selectedPrintZona = null;
    private int selectedAnio = DateTime.Now.Year;
    private Zona? selectedBonosZona = null;
    private int selectedBonosMes = DateTime.Now.Month;
    private int selectedBonosAnio = DateTime.Now.Year;
    private bool _modalDetalleVisible = false;
    private PagoViewModel? pagoSeleccionado;

    private PagoViewModel nuevoPago = new()
    {
        Fecha = DateTime.Today,
        Tipo = TipoPagoSocio.Efectivo,
        Estado = EstadoPago.PendienteAConfirmar
    };

    private Dictionary<string, object> OnRowClick(RowData<PagoViewModel> rowData)
    {
        return new Dictionary<string, object>
        {
            ["onclick"] = Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => MostrarDetallePago(rowData.Data))
        };
    }

    private void MostrarDetallePago(PagoViewModel pago)
    {
        pagoSeleccionado = pago;
        _modalDetalleVisible = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await Init();
    }

    private async Task Init()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var pagos = await PagoService.ObtenerTodosLosPagosAsync();
            PagosOriginales = pagos.Select(MapToViewModel).ToList();
            SociosList = await SocioService.ObtenerSociosAsync() ?? new List<Socio>();
            CobradoresList = (await CobradorService.ObtenerTodosLosCobradoresAsync()).ToList();

            PagosFiltrados = FiltrarPagos();
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"❌ Error al cargar los datos: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private List<PagoViewModel> FiltrarPagos()
    {
        var filtered = PagosOriginales
            .Where(p => (FechaBuscarI == default || p.Fecha.Date >= FechaBuscarI.Date) &&
                        (FechaBuscarF == default || p.Fecha.Date <= FechaBuscarF.Date) &&
                        (string.IsNullOrWhiteSpace(Busqueda) ||
                            p.NombreSocio.Contains(Busqueda, StringComparison.OrdinalIgnoreCase) ||
                            p.NumeroSocio.ToString().Contains(Busqueda)))
            .OrderByDescending(p => p.Fecha)
            .ToList();

        return filtered;
    }

    private async Task AddPago()
    {
        isLoadingComponent = true;

        if (nuevoPago.SocioId <= 0 || nuevoPago.Monto <= 0 || nuevoPago.CobradorId <= 0)
        {
            await MessageService.ErrorAsync("⚠️ Por favor, complete todos los campos obligatorios.");
            isLoadingComponent = false;
            return;
        }

        try
        {
            var nuevopago = new PagoEfectivo
            {
                SocioId = nuevoPago.SocioId,
                CobradorId = nuevoPago.CobradorId,
                Monto = nuevoPago.Monto,
                Fecha = nuevoPago.Fecha,
                Estado = EstadoPago.PendienteAConfirmar,
                Tipo = TipoPagoSocio.Efectivo,
                Observaciones = nuevoPago.Observaciones
            };

            await PagoService.AgregarPagoAsync(nuevoPago.SocioId, nuevopago);
            await MessageService.SuccessAsync("✅ Pago registrado exitosamente y enviado para confirmación.");
            
            _modalAñadirVisible = false;
            nuevoPago = new PagoViewModel
            {
                Fecha = DateTime.Today,
                Tipo = TipoPagoSocio.Efectivo,
                Estado = EstadoPago.PendienteAConfirmar
            };

            await Init();
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"❌ Error al registrar el pago: {ex.Message}");
        }
        finally
        {
            isLoadingComponent = false;
        }
    }

    private async Task ImprimirBonos()
    {
        _modalParametrosBonosVisible = true;
        _modalImprimirVisible = false;
        await Task.CompletedTask;
    }

    private void ImprimirListaCobranza()
    {
        _modalImprimirVisible = false;
        _modalParametrosCobranzaVisible = true;
    }

    private IEnumerable<Zona> GetZonasDisponibles()
    {
        return new[] { Zona.Zona1, Zona.Zona2, Zona.Zona3, Zona.Zona4, Zona.Zona5 };
    }

    private void SelectPrintZona(Zona? zona)
    {
        selectedPrintZona = zona;
    }

    private void SelectBonosZona(Zona? zona)
    {
        selectedBonosZona = zona;
    }

    private static int ObtenerNumeroZona(Zona? zona)
    {
        return zona switch
        {
            Zona.Zona1 => 1,
            Zona.Zona2 => 2,
            Zona.Zona3 => 3,
            Zona.Zona4 => 4,
            Zona.Zona5 => 5,
            _ => 0
        };
    }

    private void ConfirmPrintCobranza()
    {
        int zonaParam = ObtenerNumeroZona(selectedPrintZona);
        string url = $"/fire-force/socios/imprimibles/lista-cobranza-anual/{selectedAnio}/{zonaParam}";

        navigationManager.NavigateTo(url, forceLoad: true);
        _modalParametrosCobranzaVisible = false;
    }

    private void ConfirmPrintBonos()
    {
        int zonaParam = ObtenerNumeroZona(selectedBonosZona);
        string url = $"/fire-force/socios/imprimibles/bonos/{zonaParam}/{selectedBonosMes}/{selectedBonosAnio}";

        navigationManager.NavigateTo(url, forceLoad: true);
        _modalParametrosBonosVisible = false;
    }

    private static PagoViewModel MapToViewModel(PagoSocio pago)
    {
        return new PagoViewModel
        {
            Id = pago.Id,
            SocioId = pago.SocioId,
            NombreSocio = pago.Socio is null ? "Sin Socio" : $"{pago.Socio.Nombre} {pago.Socio.Apellido}".Trim(),
            NumeroSocio = pago.Socio?.NroSocio ?? 0,
            Fecha = pago.Fecha,
            FechaConfirmadoORechazado = pago.FechaConfirmadoORechazado,
            RazonRechazo = pago.RazonRechazo,
            Monto = pago.Monto,
            Tipo = pago.Tipo,
            Estado = pago.Estado,
            CobradorId = pago is PagoEfectivo pe ? pe.CobradorId : 0,
            NombreCobrador = pago is PagoEfectivo pe2 && pe2.Cobrador is not null
                ? $"{pe2.Cobrador.Nombre} {pe2.Cobrador.Apellido}".Trim()
                : null,
            Observaciones = pago is PagoEfectivo pe3 ? pe3.Observaciones : null
        };
    }
}