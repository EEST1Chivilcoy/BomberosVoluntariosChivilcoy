@page "/fire-force/salidas/incendio/{TipoIncendio:int}"
@page "/fire-force/salidas/incendio/{TipoIncendio:int}/{AnioSalida:int}/{NumeroSalida:int}"
@using FireForce.Client.Data.ViewModels.Personal;
@using FireForce.Client.Data.ViewModels.Rescates;
@using FireForce.Shared.Enums.Salidas;
@using FireForce.Shared.Enums.Discriminadores;

@*Servicios Utilizados*@
@using FireForce.Client.Services
@inject ISalidaService SalidaService
@inject IBomberoService BomberoService
@inject IVehiculoSalidaService VehiculoSalidaService
@inject INavigationInterception NavigationInterception
@inject IFuerzaIntervinienteService FuerzaIntervinienteService
@inject IMessageService message
@inject NavigationManager navigationManager

@*Componentes Generales*@
@using FireForce.Data.Models.Salidas.Componentes;
@* Componentes de Incendio *@

@code {
    private string activeTab = "1";

    void NextTab()
    {
        int num = int.Parse(activeTab);
        if (num < 7)
        {
            activeTab = (num + 1).ToString();
        }
    }
}

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<Form Model="@IncendioViewModel"
      LabelColSpan="8"
      WrapperColSpan="16"
      OnFinish="OnFinish"
      OnFinishFailed="OnFinishFailed"
      Style="width: 100%; height: 100%; overflow: visible;">

    <div class="abm-page--planilla">

        <!-- Encabezado -->
        <div class="planilla-encabezado">
            @switch ((TipoDeEmergencia)TipoIncendio)
            {
                case TipoDeEmergencia.IncendioComercio:
                    <h1 class="planilla-titulo">
                        INCENDIO COMERCIO
                    </h1>
                    break;
                case TipoDeEmergencia.IncendioEstablecimientoEducativo:
                    <h1 class="planilla-titulo">
                        INCENDIO ESTABLECIMIENTO EDUCATIVO
                    </h1>
                    break;
                case TipoDeEmergencia.IncendioEstablecimientoPublico:
                    <h1 class="planilla-titulo">
                        INCENDIO ESTABLECIMIENTO PÚBLICO
                    </h1>
                    break;
                case TipoDeEmergencia.IncendioForestal:
                    <h1 class="planilla-titulo">
                        INCENDIO FORESTAL
                    </h1>
                    break;
                case TipoDeEmergencia.IncendioHospitalesYClinicas:
                    <h1 class="planilla-titulo">
                        INCENDIO HOSPITALES Y CLÍNICAS
                    </h1>
                    break;
                case TipoDeEmergencia.IncendioIndustria:
                    <h1 class="planilla-titulo">
                        INCENDIO INDUSTRIA
                    </h1>
                    break;
                case TipoDeEmergencia.IncendioVivienda:
                    <h1 class="planilla-titulo">
                        INCENDIO VIVIENDA
                    </h1>
                    break;
                case TipoDeEmergencia.IncendioAeronaves:
                    <h1 class="planilla-titulo">
                        INCENDIO DE AERONAVES
                    </h1>
                    break;
                case TipoDeEmergencia.Incendio:
                    <h1 class="planilla-titulo">
                        INCENDIO (OTRO)
                    </h1>
                    break;
                default:
                    <h1 class="planilla-titulo">
                        INCENDIO (Tipo no reconocido)
                    </h1>
                    break;
            }

            <p class="planilla-subtitulo">
                Complete todos los campos requeridos para registrar la salida
            </p>
        </div>

        <!-- Tabs container -->
       <Tabs ActiveKey="@activeTab" OnChange="@(key => activeTab = key)"
        Class="custom-tabs">
            <TabPane Key="1" Tab="📋 Datos-Generales" Class="tab-general">
                <DatosGenerales Model="@IncendioViewModel" />
            </TabPane>

            <TabPane Key="2" Tab="📞 Datos Telefónicos">
                <Participantes Model="@IncendioViewModel" BomberosTodos="@BomberosVM" />
            </TabPane>

            <TabPane Key="3" Tab="🛡️ Fuerzas Intervinientes">
                <FuerzasIntervinientes Model="@IncendioViewModel" />
            </TabPane>

            <TabPane Key="4" Tab="⚠️ Afectados">
                <Damnificados Model="@IncendioViewModel" />
            </TabPane>

            <TabPane Key="5" Tab="🚒 Unidades">
                <Vehiculos Model="@IncendioViewModel" BomberosTodos="@BomberosTodos" Flota="@MovilesTodos" />
            </TabPane>

            <TabPane Key="6" Tab="🪪 Personal">
                <Personal Model="@IncendioViewModel" BomberosTodos="@BomberosVM" />
            </TabPane>

            <TabPane Key="7" Tab="🛠️ Datos Especificos">
                <TipoDeServicio Model="@IncendioViewModel" isUnlocked="true" OnCompleted="@((bool done) => {/* noop */})" />
                <div class="submit-section-firmas">
                    <FormItem WrapperColSpan="24" Style="margin: 0;">
                        <Button HtmlType="submit" Size="ButtonSize.Large" class="submit-button-firmas">
                            <Icon Type="printer" Style="margin-right: 0.5rem;" />
                            Imprimir Salida
                        </Button>
                    </FormItem>
                </div>
            </TabPane>

        </Tabs>

        @if (activeTab != "7")
    {
        <div class="planilla-nav-siguiente">
            <Button OnClick="NextTab">
                Siguiente →
            </Button>
        </div>
    }

        @if (_visible1 == true)
        {
            <ImprimirModal AnioNumeroParte="@ImprimirAnio" NumeroParte="@ImprimirNumeroParte" />
        }
    </div>
</Form>

