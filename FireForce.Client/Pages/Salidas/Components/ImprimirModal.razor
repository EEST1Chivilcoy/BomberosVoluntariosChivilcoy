@using FireForce.Client.Data.ViewModels.Incendios;
@using FireForce.Client.Data.ViewModels.Personal;
@inject NavigationManager navigationManager

@*Confirmación posterior a la carga de una salida*@
<Modal Title="Salida registrada"
       Footer="null"
       Centered
       Width="600"
       WrapClassName="modal-abm modal-imprimir-salida"
       Visible="@_visible1"
       OnCancel="@HandleCancel1">

    <div class="modal-content-abm">
        <Result Status="ResultStatus.Success"
                Title="Se cargó correctamente la salida">
        </Result>

        <p class="modal-imprimir-salida-pregunta">¿Desea imprimir la planilla de intervención?</p>

        <div class="modal-footer-abm">
            <Button OnClick="@VolverAlListado">
                No, volver al listado
            </Button>
            <Button Type="ButtonType.Primary" OnClick="@ImprimirPlanilla">
                <Icon Type="printer" /> Sí, imprimir
            </Button>
        </div>
    </div>
</Modal>

@code {
    [Parameter] public int AnioNumeroParte { get; set; }
    [Parameter] public int NumeroParte { get; set; }

    bool _visible1 = true;

    void HandleCancel1()
    {
        _visible1 = false;
    }

    private void ImprimirPlanilla()
    {
        navigationManager.NavigateTo($"/fire-force/PlanillasIntervencion/Imprimir/{AnioNumeroParte}/{NumeroParte}/{true}", true);
    }

    private void VolverAlListado()
    {
        navigationManager.NavigateTo("/fire-force/Salidas");
    }
}
