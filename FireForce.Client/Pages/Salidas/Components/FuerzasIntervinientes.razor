@using FireForce.Data.Models.Grupos.FuerzasIntervinientes
@using FireForce.Client.Data.ViewModels
@using FireForce.Client.Data.ViewModels.Personal
@using FireForce.Data.Models.Vehiculos.Flota
@using FireForce.Data.Models.Personas.Personal
@using FireForce.Client.Data.Mappers
@using FireForce.Data.Models.Salidas.Componentes

@*Servicios Utilizados*@
@using FireForce.Client.Services
@inject IMessageService MessageService
@inject IFuerzaIntervinienteService FuerzaIntervinienteService

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<div class="planilla-salida">
    <Form Model="fuerzaForm"
          Loading="_isLoading"
          ValidateOnChange="@true"
          OnFinish="OnFinish">

        <div style="margin-bottom: 24px;">
            <div class="seccion-titulo">
                <h4>Fuerza Interviniente</h4>
            </div>
            <Row Gutter="16">
                <AntDesign.Col Xs="24" Sm="12" Md="12" Lg="12">
                    <FormItem Label="Fuerza Interviniente">
                        <Select TItem="SimpleFuerzaViewModel"
                                TItemValue="int"
                                DataSource="@FuerzasIntervinientesList"
                                @bind-Value="fuerzaForm.FuerzaViewModel"
                                ValueName="@nameof(SimpleFuerzaViewModel.Id)"
                                LabelName="@nameof(SimpleFuerzaViewModel.Nombre)"
                                DefaultActiveFirstOption="@false"
                                AllowClear
                                EnableSearch>
                        </Select>
                    </FormItem>
                </AntDesign.Col>
                <AntDesign.Col Xs="24" Sm="12" Md="12" Lg="12">
                    <FormItem Label="N° Unidad">
                        <Input @bind-Value="fuerzaForm.NumeroUnidad" Placeholder="Ingrese el número de unidad" />
                    </FormItem>
                </AntDesign.Col>
            </Row>
            <Row Gutter="16">
                <AntDesign.Col Xs="24" Sm="12" Md="8" Lg="8">
                    <FormItem Label="Encargado">
                        <Input @bind-Value="fuerzaForm.EncargadoApellidoyNombre" Placeholder="Nombre del encargado" />
                    </FormItem>
                </AntDesign.Col>
            </Row>
            <Row Justify="RowJustify.End" style="margin-top: 16px;">
                <AntDesign.Col>
                    <Button Type="@ButtonType.Primary"
                            HtmlType="submit"
                            Icon="plus"
                            Class="btn-agregar">
                        Cargar Fuerza Interviniente
                    </Button>
                </AntDesign.Col>
            </Row>
        </div>
    </Form>

    @* Tabla de Fuerzas Intervinientes Cargadas *@
    @if (Model.FuerzasIntervinientes.Any())
    {
        <div style="margin-top: 32px;">
            <div class="seccion-titulo">
                <h4>
                    <Icon Type="team" style="margin-right: 8px;" />
                    Fuerzas Intervinientes Asignadas
                    <Badge Count="@Model.FuerzasIntervinientes.Count"
                           Style="margin-left: 12px; background-color: var(--abm-primary-color);" />
                </h4>
            </div>
            <div style="overflow-x: auto;">
                <Table TItem="FuerzaIntervinienteViewModel"
                       DataSource="@Model.FuerzasIntervinientes"
                       Responsive>
                    <ColumnDefinitions Context="item">
                        <PropertyColumn Title="Fuerza"
                                        Property="f => f.NombreFuerza"
                                        Align="ColumnAlign.Center">
                        </PropertyColumn>
                        <PropertyColumn Title="Encargado"
                                        Property="f => f.EncargadoApellidoyNombre"
                                        Align="ColumnAlign.Center">
                        </PropertyColumn>
                        <PropertyColumn Title="N° Unidad"
                                        Property="f => f.NumeroUnidad"
                                        Align="ColumnAlign.Center">
                        </PropertyColumn>
                        <ActionColumn Title="Acciones" Align="ColumnAlign.Center">
                            <Button Type="@ButtonType.Text"
                                    Danger
                                    Size="@ButtonSize.Large"
                                    Icon="delete"
                                    Style="font-size: 0.95rem; padding: 4px 10px;"
                                    OnClick="@(() => EliminarFuerza(item))">
                            </Button>
                        </ActionColumn>
                    </ColumnDefinitions>
                </Table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public required SalidasViewModels Model { get; set; } = null!;

    // Inicializamos explícitamente para evitar nulos en el binding inicial
    private FuerzaIntervinienteViewModel fuerzaForm = new() { FuerzaViewModel = new() };

    private bool _isLoading = true;
    private List<SimpleFuerzaViewModel> FuerzasIntervinientesList { get; set; } = new();

    private async Task EliminarFuerza(FuerzaIntervinienteViewModel fuerza)
    {
        if (Model.FuerzasIntervinientes.Contains(fuerza))
        {
            Model.FuerzasIntervinientes.Remove(fuerza);
            await MessageService.SuccessAsync("Fuerza interviniente eliminada");
        }
    }

    private async Task<List<SimpleFuerzaViewModel>> LoadFuerzasIntervinientesAsync()
    {
        var fuerzas = await FuerzaIntervinienteService.ObtenerTodasLasFuerzasAsync();

        // Pequeña optimización: si la lista es null, devolvemos vacía para evitar excepciones en el Select
        if (fuerzas == null) return new List<SimpleFuerzaViewModel>();

        return fuerzas.Select(f => new SimpleFuerzaViewModel
        {
            Id = f.Id,
            Nombre = f.NombreFuerza ?? "Sin Nombre" // Manejo de posible string null
        }).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            FuerzasIntervinientesList = await LoadFuerzasIntervinientesAsync();
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"Error al cargar fuerzas: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnFinish(EditContext editContext)
    {
        try
        {
            // 1. VALIDACIÓN: Campos Obligatorios
            ValidationHelper.Validar(fuerzaForm);

            // 2. MEJORA: Simplificación de Lógica de Duplicados
            // No es necesario chequear (Fuerza + Unidad + Encargado).
            // Si la regla es que un móvil (Fuerza + Unidad) es único en la salida, esta validación basta y sobra.
            bool unidadRepetida = Model.FuerzasIntervinientes.Any(f =>
                f.FuerzaViewModel == fuerzaForm.FuerzaViewModel! &&
                f.NumeroUnidad!.Trim().Equals(fuerzaForm.NumeroUnidad!.Trim(), StringComparison.OrdinalIgnoreCase));

            if (unidadRepetida)
            {
                await MessageService.WarningAsync($"La unidad {fuerzaForm.NumeroUnidad} de esta fuerza ya ha sido asignada.");
                return;
            }

            // 3. Extraer nombre de fuerza para el ViewModel
            string nombreFuerza = FuerzasIntervinientesList
                .FirstOrDefault(f => f.Id == fuerzaForm.FuerzaViewModel!)?.Nombre ?? "Desconocida";

            fuerzaForm.NombreFuerza = nombreFuerza;

            Model.FuerzasIntervinientes.Add(fuerzaForm);

            // Reiniciar formulario limpiamente
            fuerzaForm = new() { FuerzaViewModel = new() };

            await MessageService.SuccessAsync("Fuerza interviniente agregada.");
        }
        catch (Exception ex)
        {
            await MessageService.ErrorAsync($"Error al agregar fuerza interviniente: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }
}