@using FireForce.Client.Data.ViewModels.Personal;
@using FireForce.Data.Models.Vehiculos.Flota;

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<table class="planilla-salida-tabla">
    <thead>
        <tr>
            <th>MOVIL</th>
            <th>KM LLEGADA</th>
            <th>CHOFER</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Movil in movilesSalida)
        {
            <tr>
                <td>@Movil.Movil.NumeroMovil</td>
                <td>@Movil.KmLlegada</td>
                <td>@($"{Movil.Chofer.Apellido}, {Movil.Chofer.Nombre}")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public List<Movil_Salida> movilesSalida { get; set; }
}
