@using FireForce.Client.Data.ViewModels.Personal;
@using FireForce.Data.Models.Personas;

@* Los estilos viven en wwwroot/css/abm.css. No agregar <style> acá. *@

<table class="planilla-salida-tabla">
    <thead>
        <tr>
            <th>APELLIDO Y NOMBRE</th>
            <th>DOCUMENTO</th>
            <th>SEXO</th>
            <th>EDAD</th>
            <th>ESTADO</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Damnificado in Damnificados)
        {
            <tr>
                <td>@Damnificado.Apellido, @Damnificado.Nombre</td>
                <td>@Damnificado.Documento</td>
                <td>@Damnificado.Sexo</td>
                <td>@Damnificado.Edad</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public List<Damnificado_Salida>? Damnificados { get; set; }
}
